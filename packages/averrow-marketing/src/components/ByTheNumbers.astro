---
/*
 * "By the numbers" — homepage proof section (Section 2).
 *
 * Renders from src/data/stats.json at build (the fallback), then a small
 * vanilla script fetches /api/v1/public/stats on the same origin and updates
 * values + the timestamp in place. Per field: a missing/invalid value keeps
 * the build value. Nothing here names a feed, vendor, threshold or customer
 * (docs/DISCLOSURE_REGISTER.md); every figure is an aggregate, and the
 * methodology page says what each one counts.
 */
import liveStats from "../data/stats.json";
import { CHANGELOG_ENTRIES } from "../data/changelog-entries";
import TrustSignals from "./TrustSignals.astro";
import {
  buildBars,
  exact,
  lookalikes30dLabel,
  parseThreatTypes,
  renderBars,
  renderTableRows,
  roundLabel,
  sourcesLabel,
  typeTotal,
  utcDate,
} from "../lib/proof";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const live = liveStats.live;
const fb = liveStats.fallbacks;

const types = parseThreatTypes(live.threat_types) ?? [];
const bars = buildBars(types);
const classified = typeTotal(types);

const dash = "–";
const val = {
  total: live.total_threats != null ? exact(live.total_threats) : dash,
  today: live.threats_today != null ? exact(live.threats_today) : dash,
  ops: live.operations_tracked != null ? exact(live.operations_tracked) : dash,
  lookalikes: lookalikes30dLabel(live.lookalikes_found_30d, fb.lookalikes_found_30d) ?? dash,
  brands: live.monitored_brands != null ? exact(live.monitored_brands) : dash,
  providers: live.providers_mapped != null ? roundLabel(live.providers_mapped) : dash,
  countries: live.countries != null ? String(live.countries) : dash,
  sources: live.active_feeds != null ? sourcesLabel(live.active_feeds) : "40+",
};

const snapshot = utcDate(liveStats.generated_at) ?? "";

// Computed, never hard-coded: the count and latest version come from the manifest.
const releaseCount = CHANGELOG_ENTRIES.length;
const latestVersion = CHANGELOG_ENTRIES[0]?.version ?? "";

const tiles = [
  { key: "today", label: "new today", desc: "Indicators added across every source since 00:00 UTC." },
  { key: "ops", label: "active operations", desc: "Groups of threats that share hosting, certificates or registration patterns, active in the last 30 days." },
  { key: "lookalikes", label: "lookalike domains found", desc: "Registered domains imitating a monitored brand, found in the last 30 days." },
  { key: "brands", label: "brands monitored", desc: "Continuous lookalike, certificate and threat-feed coverage." },
  { key: "providers", label: "hosting providers mapped", desc: "" },
  { key: "sources", label: "intelligence sources", desc: "Phishing, malware and infrastructure feeds, correlated together." },
] as const;

const checks = [
  {
    title: "Try it on your own domain",
    body: "Run a free scan on your own domain, no signup. See what Averrow finds before you talk to anyone.",
    cta: "Scan your domain",
    href: `${base}/scan`,
  },
  {
    title: "We ship in the open",
    body: `${releaseCount} public releases, latest ${latestVersion}. Every change is listed.`,
    cta: "Read the changelog",
    href: `${base}/changelog`,
  },
  {
    title: "Uptime is public",
    body: "Our status page shows platform health as it happens.",
    cta: "View status",
    href: `${base}/status`,
  },
  {
    title: "See a sample report",
    body: "An illustrative operation report: domains, hosting, timeline and takedowns.",
    cta: "Open sample report",
    href: `${base}/resources/sample-operation-report`,
  },
];
---

<section
  class="num"
  id="by-the-numbers"
  aria-labelledby="num-title"
  data-proof
  data-snapshot={snapshot}
>
  <div class="num-head">
    <div>
      <div class="num-eyebrow">By the numbers</div>
      <h2 class="num-h" id="num-title">What the platform sees, counted plainly.</h2>
    </div>
    <div class="num-meta">
      <span class="num-live"><i data-live-dot></i><span data-stamp>Build snapshot, {snapshot}</span></span>
      <a href={`${base}/resources/methodology`}>How we count each number &rarr;</a>
    </div>
  </div>

  <div class="num-grid">
    <div class="num-chart" data-chart>
      <div class="num-ct">
        <b>Threats tracked, by type</b>
        <span><span data-stat="total_threats">{val.total}</span> total &middot; all sources</span>
      </div>
      <div class="num-bars" data-bars role="group" aria-label="Threats tracked, by type" set:html={renderBars(bars, classified)} />
      <div class="num-tip" data-tip hidden></div>
      <p class="num-cf">Counts since launch. Hover or focus a bar for its share of classified threats.</p>
      <div class="num-sr" aria-hidden="true">
        <table aria-label="Threats tracked, by type (data table)">
          <thead><tr><th scope="col">Threat type</th><th scope="col">Threats</th><th scope="col">Share of classified</th></tr></thead>
          <tbody data-table set:html={renderTableRows(bars, classified)} />
        </table>
      </div>
    </div>

    <div class="num-tiles">
      {tiles.map((t) => (
        <div class="num-tile" data-tile={t.key}>
          <b data-stat={t.key}>{val[t.key]}</b>
          <span class="num-tl">{t.label}</span>
          {t.key === "providers" ? (
            <span class="num-td">Across <span data-stat="countries">{val.countries}</span> countries, so you see where attacks are hosted.</span>
          ) : (
            <span class="num-td">{t.desc}</span>
          )}
        </div>
      ))}
    </div>
  </div>

  <div class="num-check">
    <div class="num-k">Check it yourself</div>
    <div class="num-cards">
      {checks.map((c) => (
        <a class="num-card" href={c.href} data-check>
          <b>{c.title}</b>
          <span>{c.body}</span>
          <em>{c.cta} &rarr;</em>
        </a>
      ))}
    </div>
  </div>

  <TrustSignals />
</section>

<style is:global>
  .num {
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 24px 40px;
    display: grid;
    gap: 26px;
  }
  .num-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .num-eyebrow {
    font: 600 12px var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-section, var(--accent));
    margin-bottom: 10px;
  }
  .num-h {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
    color: var(--text-primary);
  }
  .num-meta { display: grid; gap: 6px; justify-items: end; font: 500 12px var(--font-mono); color: var(--text-secondary); }
  .num-meta a {
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
    font: 600 13px var(--font-display);
  }
  .num-meta a:hover { border-bottom-color: var(--accent); }
  .num-live { display: flex; align-items: center; gap: 8px; min-width: 31ch; justify-content: flex-end; }
  .num-live i { width: 7px; height: 7px; border-radius: 50%; background: var(--text-tertiary); flex: none; }
  .num[data-state="live"] .num-live i { background: var(--green); }

  .num-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px; }
  .num-chart {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 18px 14px;
  }
  .num-ct { display: flex; justify-content: space-between; gap: 6px 10px; flex-wrap: wrap; margin-bottom: 14px; font-size: 13px; }
  .num-ct b { color: var(--text-primary); }
  .num-ct > span { color: var(--text-secondary); font: 500 11.5px var(--font-mono); }
  .num-bars { display: grid; gap: 14px; flex: 1; align-content: space-between; }
  .num-bar {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) 52px;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-secondary);
    cursor: default;
    padding: 2px 0;
  }
  .num-bar-tr { display: block; height: 12px; border-radius: 0 4px 4px 0; background: var(--border); overflow: hidden; }
  .num-bar-f { display: block; height: 100%; border-radius: 0 4px 4px 0; background: var(--amber); }
  /* Light theme: fills must clear 3:1 against the track (#E2DDD5). */
  [data-theme="light"] .num-bar-f { background: var(--accent-section, #8A5F0F); }
  .num-bar.grp .num-bar-f { background: var(--slate); }
  [data-theme="light"] .num-bar.grp .num-bar-f { background: var(--slate-text); }
  .num-bar-v { font: 600 12px var(--font-mono); color: var(--text-primary); text-align: right; font-variant-numeric: tabular-nums; }
  .num-bar:hover .num-bar-f, .num-bar:focus-visible .num-bar-f { filter: brightness(1.15); }
  .num-bar:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .num-tip {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    background: var(--bg-elevated, var(--bg-secondary));
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 12px;
    color: var(--text-primary);
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
  }
  .num-tip span { color: var(--text-secondary); font-family: var(--font-mono); }
  .num-cf { margin: 12px 0 0; font: 500 11px var(--font-mono); color: var(--text-secondary); }
  .num-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .num-tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    min-width: 0;
  }
  .num-tile { background: var(--bg-secondary); padding: 14px 16px; display: grid; gap: 3px; align-content: start; min-width: 0; }
  .num-tile b { font: 800 24px/1.1 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; min-height: 1.1em; }
  .num-tl { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  .num-td { font-size: 12px; line-height: 1.45; color: var(--text-secondary); }

  .num-k { font: 600 10.5px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-secondary); margin-bottom: 10px; }
  .num-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .num-card {
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    padding: 14px;
    display: grid;
    gap: 6px;
    align-content: start;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .num-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
  .num-card b { font-size: 14px; color: var(--text-primary); }
  .num-card span { font-size: 12.5px; line-height: 1.45; color: var(--text-secondary); }
  .num-card em { font-style: normal; font-size: 12.5px; font-weight: 700; color: var(--amber-text); margin-top: 4px; }
  [data-theme="light"] .num-card em { color: var(--accent-section, #8A5F0F); }

  .num .trust-line { padding-top: 6px; border-top: 1px solid var(--border); padding-top: 18px; }

  @media (max-width: 959px) {
    .num-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 859px) {
    .num-grid { grid-template-columns: minmax(0, 1fr); }
    .num-tiles { order: -1; }
  }
  @media (max-width: 699px) {
    .num { padding: 40px 16px 28px; gap: 18px; }
    .num-meta { justify-items: start; }
    .num-live { justify-content: flex-start; min-width: 0; }
    .num-bar { grid-template-columns: 104px minmax(0, 1fr) 44px; font-size: 11.5px; gap: 8px; }
    .num-tile b { font-size: 20px; }
    .num-tile { padding: 12px; }
    .num-cards { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import {
    buildBars,
    exact,
    parseLive,
    renderBars,
    renderTableRows,
    roundLabel,
    sourcesLabel,
    typeTotal,
    utcStamp,
  } from "../lib/proof";

  const root = document.querySelector<HTMLElement>("[data-proof]");

  function setText(sel: string, text: string | null) {
    if (text === null) return;
    document.querySelectorAll<HTMLElement>(sel).forEach((el) => {
      el.textContent = text;
    });
  }

  // Hover / focus tooltip, delegated so it survives the live re-render.
  const chart = root?.querySelector<HTMLElement>("[data-chart]");
  const tip = chart?.querySelector<HTMLElement>("[data-tip]");
  function showTip(bar: HTMLElement) {
    if (!chart || !tip) return;
    tip.innerHTML = "";
    const b = document.createElement("b");
    b.textContent = bar.dataset.label ?? "";
    const s = document.createElement("span");
    s.textContent = ` ${bar.dataset.count} · ${bar.dataset.share}`;
    tip.append(b, s);
    if (bar.dataset.note) {
      tip.append(document.createElement("br"));
      const n = document.createElement("span");
      n.textContent = bar.dataset.note;
      tip.append(n);
    }
    tip.hidden = false;
    const cb = chart.getBoundingClientRect();
    const eb = bar.getBoundingClientRect();
    const left = Math.max(8, Math.min(cb.width - tip.offsetWidth - 8, eb.left - cb.left + 120));
    tip.style.left = `${left}px`;
    tip.style.top = `${eb.top - cb.top - tip.offsetHeight - 4}px`;
  }
  function hideTip() {
    if (tip) tip.hidden = true;
  }
  const barOf = (t: EventTarget | null) => (t instanceof Element ? (t.closest(".num-bar") as HTMLElement | null) : null);
  chart?.addEventListener("mouseover", (e) => {
    const b = barOf(e.target);
    if (b) showTip(b);
  });
  chart?.addEventListener("mouseout", (e) => {
    if (barOf(e.target)) hideTip();
  });
  chart?.addEventListener("focusin", (e) => {
    const b = barOf(e.target);
    if (b) showTip(b);
  });
  chart?.addEventListener("focusout", hideTip);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hideTip();
  });

  async function refresh() {
    if (!root) return;
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), 6000);
    try {
      const res = await fetch("/api/v1/public/stats", { headers: { accept: "application/json" }, signal: ctrl.signal });
      if (!res.ok) return;
      const parsed = parseLive(await res.json());
      if (!parsed) return;
      const n = parsed.numbers;

      // Each field updates only when valid; otherwise the build value stays.
      setText('[data-stat="total_threats"]', n.total_threats !== null ? exact(n.total_threats) : null);
      setText('[data-stat="today"]', n.threats_today !== null ? exact(n.threats_today) : null);
      setText('[data-stat="ops"]', n.operations_tracked !== null ? exact(n.operations_tracked) : null);
      setText('[data-stat="lookalikes"]', n.lookalikes_found_30d !== null ? roundLabel(n.lookalikes_found_30d) : null);
      setText('[data-stat="brands"]', n.monitored_brands !== null ? exact(n.monitored_brands) : null);
      setText('[data-stat="providers"]', n.providers_mapped !== null ? roundLabel(n.providers_mapped) : null);
      setText('[data-stat="countries"]', n.countries !== null ? String(n.countries) : null);
      setText('[data-stat="sources"]', n.active_feeds !== null ? sourcesLabel(n.active_feeds) : null);

      if (n.threat_types) {
        const bars = buildBars(n.threat_types);
        if (bars.length > 0) {
          const total = typeTotal(n.threat_types);
          const host = root.querySelector<HTMLElement>("[data-bars]");
          const body = root.querySelector<HTMLElement>("[data-table]");
          if (body) body.innerHTML = renderTableRows(bars, total);
          // Don't yank focus: leave the bars alone while one of them is focused.
          if (host && !host.contains(document.activeElement)) {
            host.innerHTML = renderBars(bars, total);
            hideTip();
          }
        }
      }

      const stamp = utcStamp(parsed.generatedAt ?? Date.now());
      if (stamp) {
        setText("[data-stamp]", `Refreshed ${stamp}`);
        root.dataset.state = "live";
      }
    } catch {
      // Network failure, abort or bad JSON: the build snapshot stays on screen.
    } finally {
      clearTimeout(timer);
    }
  }

  void refresh();
</script>
