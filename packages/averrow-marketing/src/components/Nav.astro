---
/*
 * Top navigation bar. Five hub links (Platform / Solutions / Pricing /
 * Research / Company), a text "Log in", a secondary "Book a demo" and
 * the primary amber "Scan your domain". The theme toggle lives in the
 * footer. Active link is decided server-side from the current path so
 * there's no hydration flash.
 *
 * Log in -> /login (worker 302 -> /v2/login). That is the single shared
 * sign-in page (passkey / Google / magic link): `client` (customer)
 * accounts are sent on to /tenant/ by the worker after sign-in
 * (handlers/auth.ts, "Phase D D2c rebadge gate"), staff land in /v2.
 * /tenant/ itself cannot be the target: signed-out visitors there are
 * bounced to "/".
 *
 * Pages that include this Layout get the Nav automatically.
 */
import { NAV_LINKS, LOGIN_HREF, activeFor } from "../lib/nav";

const currentPath = Astro.url.pathname;
const activeHref = activeFor(currentPath);

// Internal links pick up the Astro base ("/" in production, so a no-op).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (href: string) => `${base}${href}`;
---

<nav class="nav" aria-label="Main">
  <div class="nav-inner">
    <a href={withBase("/")} class="nav-brand" aria-label="Averrow home">
      <svg width="28" height="28" viewBox="0 0 32 32" style="flex-shrink:0" aria-hidden="true">
        <defs>
          <linearGradient id="deep-arrow-nav" x1="16" y1="5" x2="16" y2="26" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#6B1010" />
            <stop offset="100%" stop-color="#C83C3C" />
          </linearGradient>
        </defs>
        <rect width="32" height="32" rx="6" fill="#080E18" />
        <path d="M16 5L26 26H18L16 21L14 26H6Z" fill="url(#deep-arrow-nav)" />
        <path d="M14.5 22H17.5L16 18Z" fill="#080E18" />
      </svg>
      <div>
        <span class="nav-brand-text">AVERROW</span>
        <span class="nav-brand-sub">THREAT INTELLIGENCE</span>
      </div>
    </a>

    <ul class="nav-links">
      {NAV_LINKS.map(link => (
        <li class="nav-item">
          <a
            href={withBase(link.href)}
            class:list={["nav-link", { "is-active": activeHref === link.href }]}
            data-path={link.href}
            aria-current={activeHref === link.href ? "true" : undefined}
          >
            <span class="nav-link-label">{link.label}</span>
            {link.children && <span class="nav-chevron" aria-hidden="true"></span>}
          </a>
          {link.children && (
            <ul class="nav-menu">
              {link.children.map(child => (
                <li>
                  <a href={withBase(child.href)}>
                    {child.label}
                    {child.desc && <small>{child.desc}</small>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    <div class="nav-right">
      <a href={withBase(LOGIN_HREF)} class="nav-login" data-cta="nav-login">Log in</a>
      <a href={withBase("/demo")} class="btn btn-outline nav-cta nav-cta-secondary" data-cta="nav-book-demo">Book a demo</a>
      <a href={withBase("/scan")} class="btn btn-primary nav-cta" data-cta="nav-scan">Scan your domain</a>
      <button
        class="nav-hamburger"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-toggle-mobile-menu
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  {NAV_LINKS.map(link => (
    <a
      href={withBase(link.href)}
      class:list={["mobile-link", { "is-active": activeHref === link.href }]}
      data-path={link.href}
    >
      <span>{link.label}</span>
    </a>
  ))}
  <div class="mobile-menu-divider"></div>
  <a href={withBase(LOGIN_HREF)} class="mobile-link mobile-link-secondary" data-cta="nav-login">Log in</a>
  <a href={withBase("/demo")} class="mobile-link mobile-link-secondary" data-cta="nav-book-demo">Book a demo</a>
  <a href={withBase("/scan")} class="mobile-link mobile-link-primary" data-cta="nav-scan">Scan your domain</a>
</div>

<script>
  // Mobile menu toggle + nav scroll shadow. Tiny, no framework.
  (function () {
    const button = document.querySelector<HTMLButtonElement>("[data-toggle-mobile-menu]");
    const menu = document.getElementById("mobile-menu");
    if (button && menu) {
      button.addEventListener("click", () => {
        const open = menu.classList.toggle("open");
        menu.setAttribute("aria-hidden", open ? "false" : "true");
        button.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }

    const nav = document.querySelector(".nav");
    if (nav) {
      const onScroll = () => {
        if (window.scrollY > 20) nav.classList.add("nav-scrolled");
        else nav.classList.remove("nav-scrolled");
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  })();
</script>
