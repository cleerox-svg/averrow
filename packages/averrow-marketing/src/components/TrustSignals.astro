---
/*
 * Trust line — the honest, verifiable posture statements only. No sector
 * icons (they implied customers) and no unverified compliance claims.
 * Copy governed by docs/DISCLOSURE_REGISTER.md. Used inside the homepage
 * "By the numbers" section and on /pricing (wrapped in
 * <section class="trust-signals">, whose padding lives below).
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<ul class="trust-line" aria-label="Trust and data handling">
  <li>SOC 2 Type I in preparation</li>
  <li><a href={`${base}/legal/dpa`}>Sub-processors listed in our DPA</a></li>
  <li>Customer data is never used in public numbers</li>
</ul>

<style is:global>
  .trust-signals {
    padding: 40px 24px 24px;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .trust-line {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .trust-line li { display: flex; align-items: center; }
  .trust-line li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-tertiary);
    margin: 0 14px;
    flex: none;
  }
  .trust-line a {
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-strong);
    text-decoration: none;
  }
  .trust-line a:hover { border-bottom-color: var(--accent); }
  @media (max-width: 640px) {
    .trust-signals { padding: 32px 16px 20px; }
    .trust-line { flex-direction: column; align-items: center; }
    .trust-line li + li::before { display: none; }
  }
</style>
