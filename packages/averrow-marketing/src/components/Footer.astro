---
/*
 * Footer — brand + six link columns (Platform / Solutions / Get started / Research / Company / Legal).
 * Mirrors the back-end footer pattern. Internal links pick up the
 * Astro base prefix so they work whether we're under /marketing/*
 * (pre-cutover) or / (post-cutover). Hosts the site's theme toggle.
 */
import BrandLockup from "./BrandLockup.astro";
import ThemeCycle from "../islands/ThemeCycle";
import { LOGIN_HREF, NAV_LINKS } from "../lib/nav";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (href: string) => `${base}${href}`;
const year = new Date().getFullYear();
// The Platform dropdown is the single list of the eight platform pages.
const platformPages = NAV_LINKS.find((l) => l.href === "/platform")?.children ?? [];
// Likewise the Solutions and Company dropdowns are the single lists for those columns.
const solutionPages = NAV_LINKS.find((l) => l.href === "/solutions")?.children ?? [];
const companyPages = NAV_LINKS.find((l) => l.href === "/company")?.children ?? [];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand-block">
        <a href={withBase("/")} class="nav-brand" style="margin-bottom:0.5rem" aria-label="Averrow home">
          <BrandLockup size="footer" />
        </a>
        <p>Brand protection and threat-actor intelligence. Find the fakes aimed at your brand, trace the operation behind them, and take them down.</p>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Platform</div>
        <ul>
          {platformPages.map((p) => <li><a href={withBase(p.href)}>{p.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Solutions</div>
        <ul>
          {solutionPages.map((p) => <li><a href={withBase(p.href)}>{p.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Get started</div>
        <ul>
          <li><a href={withBase("/pricing")}>Plans</a></li>
          <li><a href={withBase("/scan")}>Scan your domain</a></li>
          <li><a href={withBase("/demo")}>Book a demo</a></li>
          <li><a href={withBase(LOGIN_HREF)}>Log in</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Research</div>
        <ul>
          <li><a href={withBase("/resources")}>Resources</a></li>
          <li><a href={withBase("/docs")}>Docs</a></li>
          <li><a href={withBase("/blog")}>Blog</a></li>
          <li><a href={withBase("/changelog")}>Changelog</a></li>
          <li><a href={withBase("/security")}>Security</a></li>
          <li><a href={withBase("/status")}>Status</a></li>
          <li><a href={withBase("/report-abuse")}>Report Abuse</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Company</div>
        <ul>
          {companyPages.map((p) => <li><a href={withBase(p.href)}>{p.label}</a></li>)}
        </ul>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Legal</div>
        <ul>
          <li><a href={withBase("/privacy")}>Privacy</a></li>
          <li><a href={withBase("/terms")}>Terms</a></li>
          <li><a href={withBase("/legal/dpa")}>DPA</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-legal">&copy; {year} LRX Enterprises Inc. All rights reserved.</span>
      <ThemeCycle client:load />
    </div>
  </div>
</footer>
