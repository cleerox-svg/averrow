---
/*
 * Keeps a long block short on phones. Above 640px the slot renders as-is.
 * At 640px and below it renders inside a <details> (closed by default) with a
 * one-line summary, so the page stays short without JS. Both are rendered and
 * one is hidden by CSS (display:none also removes it from the accessibility
 * tree), the same pattern as StepList and the homepage Coverage section. The
 * slot is rendered twice, so keep ids out of the slotted content.
 *
 * Props: summary (the visible line that opens the fold), open (start open).
 */
interface Props {
  summary: string;
  open?: boolean;
}
const { summary, open = false } = Astro.props;
---

<div class="mf">
  <div class="mf-full"><slot /></div>
  <details class="mf-d" open={open}>
    <summary>{summary}</summary>
    <div class="mf-b"><slot /></div>
  </details>
</div>

<style>
  .mf { min-width: 0; }
  .mf-d { display: none; }
  .mf-d summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 48px;
    padding: 12px;
    cursor: pointer;
    list-style: none;
    font: 700 15px var(--font-display);
    color: var(--text-primary);
  }
  .mf-d summary::-webkit-details-marker { display: none; }
  .mf-d summary::after { content: "+"; font: 600 18px var(--font-mono); color: var(--text-secondary); }
  .mf-d[open] summary::after { content: "\2212"; }
  .mf-d summary:focus-visible { outline: 2px solid var(--amber-text); outline-offset: -2px; }
  .mf-b { padding: 0 12px 14px; }
  @media (max-width: 640px) {
    .mf-full { display: none; }
    .mf-d { display: block; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; }
  }
</style>
