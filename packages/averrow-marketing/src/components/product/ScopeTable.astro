---
/*
 * What is covered and what is not, side by side. The "not covered" column is
 * required: honest limits are part of the claim (docs/DISCLOSURE_REGISTER.md).
 * Desktop: a real <table> (Area / Covered / Not covered). Below 640px each row
 * becomes a <details>. Both are rendered; CSS hides one.
 *
 * Props: rows (ScopeRow[]: area, covered, notCovered), caption (visually hidden
 * table caption for screen readers).
 */
import type { ScopeRow } from "./types";

interface Props {
  rows: ScopeRow[];
  caption?: string;
}
const { rows, caption = "What is and is not covered" } = Astro.props;
---

<div class="st" data-scope-table>
  <table class="st-table">
    <caption class="st-sr">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Area</th>
        <th scope="col"><span class="st-mk yes" aria-hidden="true">+</span>Covered</th>
        <th scope="col"><span class="st-mk no" aria-hidden="true">&minus;</span>Not covered</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.area}</th>
          <td>{r.covered}</td>
          <td>{r.notCovered}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <div class="st-list">
    {rows.map((r) => (
      <details class="st-d">
        <summary><h3>{r.area}</h3></summary>
        <dl class="st-db">
          <dt><span class="st-mk yes" aria-hidden="true">+</span>Covered</dt>
          <dd>{r.covered}</dd>
          <dt><span class="st-mk no" aria-hidden="true">&minus;</span>Not covered</dt>
          <dd>{r.notCovered}</dd>
        </dl>
      </details>
    ))}
  </div>
</div>

<style>
  .st-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    table-layout: fixed;
  }
  .st-table th, .st-table td { text-align: left; vertical-align: top; padding: 14px 16px; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }
  .st-table tbody tr:last-child > * { border-bottom: 0; }
  .st-table thead th {
    font: 600 12px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: var(--bg-tertiary);
  }
  .st-table thead th:first-child { width: 22%; }
  .st-table tbody th { font: 700 14px var(--font-display); color: var(--text-primary); }
  .st-table td { font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .st-table td:nth-child(2) { color: var(--text-primary); }
  .st-mk {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    margin-right: 8px;
    border-radius: 999px;
    border: 1px solid currentColor;
    font: 700 13px/1 var(--font-mono);
    letter-spacing: 0;
    vertical-align: middle;
  }
  .st-mk.yes { color: var(--green-text); }
  .st-mk.no { color: var(--text-secondary); }
  .st-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .st-list { display: none; }
  .st-d { border-bottom: 1px solid var(--border); background: var(--bg-secondary); }
  .st-d:last-child { border-bottom: 0; }
  .st-d summary { display: flex; align-items: center; gap: 8px; padding: 12px; min-height: 48px; cursor: pointer; list-style: none; }
  .st-d summary::-webkit-details-marker { display: none; }
  .st-d summary::after { content: "+"; font: 600 18px var(--font-mono); color: var(--text-secondary); margin-left: auto; }
  .st-d[open] summary::after { content: "\2212"; }
  .st-d summary:focus-visible { outline: 2px solid var(--amber-text); outline-offset: -2px; }
  .st-d h3 { margin: 0; font: 700 15px var(--font-display); color: var(--text-primary); }
  .st-db { margin: 0; padding: 0 12px 14px; display: grid; gap: 4px; }
  .st-db dt { font: 600 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); margin-top: 6px; }
  .st-db dd { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-primary); }

  @media (max-width: 640px) {
    .st-table { display: none; }
    .st-list { display: grid; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  }
</style>
