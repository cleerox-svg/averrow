---
/*
 * A dated grid of company facts: label, value, optional note, under one
 * "as of" line. Used once, on /company. A fact grid without a date reads as
 * permanent, so the line is rendered as a <time>. The date is the build's
 * stats.json snapshot date (the same source ProofStrip uses, so no two
 * stamps on the site can disagree); with no valid date the line is omitted. Values are plain text from the owner-confirmed facts in
 * docs/DISCLOSURE_REGISTER.md section 3.11; never put a number here that is
 * not backed there.
 *
 * Props: items ({ label, value, note? }[]), heading (accessible name).
 */
import liveStats from "../../data/stats.json";
import { utcDate } from "../../lib/proof";

interface Fact {
  label: string;
  value: string;
  note?: string;
}
interface Props {
  items: Fact[];
  heading?: string;
}
const { items, heading = "Company facts" } = Astro.props;
const asOf = liveStats.generated_at;
const stamp = utcDate(asOf);
---

<section class="fg" aria-label={heading} data-fact-grid>
  <dl class="fg-grid">
    {items.map((i) => (
      <div class="fg-i">
        <dt>{i.label}</dt>
        <dd>{i.value}{i.note && <span class="fg-n">{i.note}</span>}</dd>
      </div>
    ))}
  </dl>
  {stamp && <p class="fg-f"><time datetime={asOf.slice(0, 10)}>Facts as of {stamp}</time></p>}
</section>

<style>
  .fg { display: grid; gap: 12px; min-width: 0; }
  .fg-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--border-strong);
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    overflow: hidden;
  }
  .fg-i { background: var(--bg-secondary); padding: 14px 16px; display: grid; gap: 4px; align-content: start; min-width: 0; }
  .fg-i dt { font: 600 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); }
  .fg-i dd { margin: 0; font: 700 16px/1.35 var(--font-display); color: var(--text-primary); overflow-wrap: anywhere; }
  .fg-n { display: block; margin-top: 2px; font: 400 13px/1.45 var(--font-body); color: var(--text-secondary); }
  .fg-f { margin: 0; font: 500 12px var(--font-mono); color: var(--text-secondary); }
</style>
