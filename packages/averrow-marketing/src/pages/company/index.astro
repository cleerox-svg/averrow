---
/*
 * Company hub (Section 9B). One page for who runs Averrow, how to reach the
 * right person, what a visitor can check about us, and the press and careers
 * material that used to live on their own pages (#press, #careers).
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L35-L47, section 3.11): legal entity
 * and country only (no address, headcount, offices, funding or named team);
 * the four monitored mailboxes; no response-time promise; no customers, logos,
 * press coverage or partners; SOC 2 Type I is "in preparation". Principles are
 * stated once, on /about.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import FactGrid from "../../components/product/FactGrid.astro";
import FactList from "../../components/product/FactList.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import { BOILERPLATE, BRAND_ASSETS, CONTACT_ROUTES, LEGAL_ENTITY, REPLY_LINE, contactEmail } from "../../lib/company";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hello = contactEmail("support");

const facts = [
  { label: "Operated by", value: LEGAL_ENTITY, note: "A Canadian-incorporated company." },
  { label: "Product", value: "Averrow", note: "Digital risk protection and threat intelligence." },
  { label: "Free domain scan", value: "No signup", note: "Run it on your own domain before talking to us." },
  { label: "SOC 2 Type I", value: "In preparation", note: "Not yet completed." },
];

const trust = [
  { href: "/security", label: "Security and trust", text: "Controls in place today and compliance status." },
  { href: "/status", label: "Service status", text: "Public service status and incident history." },
  { href: "/legal/dpa", label: "Data processing addendum", text: "The DPA, including the sub-processor list." },
  { href: "/privacy", label: "Privacy policy", text: "What we collect and why." },
  { href: "/terms", label: "Terms of service", text: "The terms that apply to using Averrow." },
];

const fastFacts = [
  { lead: "Company.", text: `${LEGAL_ENTITY}, a Canadian company.` },
  { lead: "Category.", text: "Digital risk protection and brand protection." },
  { lead: "What it does.", text: "Finds look-alike domains, impersonation accounts, copycat apps and phishing aimed at a brand, and files takedowns under the customer's authorization." },
  { lead: "Free scan.", text: "A domain scan with no signup." },
  { lead: "Founder.", text: "Claude Leroux." },
];
---

<ProductPage
  title="Company — Averrow"
  description="Averrow is operated by LRX Enterprises Inc., a Canadian company. Company facts, contact addresses, trust documents, press kit and careers."
>
  <ProductHero
    eyebrow="Company"
    plan={null}
    title="The company behind Averrow."
    sub={`Averrow is operated by ${LEGAL_ENTITY}, a Canadian company. Here is how to reach us, what you can check about us yourself, and the material for press.`}
  />

  <ProductSection id="facts" eyebrow="At a glance" heading="Company facts">
    <FactGrid items={facts} />
    <p class="co-more">
      More about us: <a href={`${base}/about`}>About Averrow</a>, <a href={`${base}/why-averrow`}>Why Averrow</a>.
    </p>
  </ProductSection>

  <ProductSection id="contact" eyebrow="Contact" heading="Reach the right person" lede={`Pick the address that fits. ${REPLY_LINE}`}>
    <ul class="co-routes" role="list">
      {CONTACT_ROUTES.map((r) => (
        <li class="co-card">
          <h3>{r.label}</h3>
          <p>{r.text}</p>
          <a class="co-mail" href={`mailto:${r.email}`}>{r.email}</a>
        </li>
      ))}
    </ul>
    <p class="co-more">
      Prefer a form? <a href={`${base}/contact`}>Contact us</a> or <a href={`${base}/demo`}>book a demo</a>.
    </p>
  </ProductSection>

  <ProductSection id="trust" eyebrow="Trust" heading="Check us yourself" lede="The documents and pages that back what we say.">
    <ul class="co-links" role="list">
      {trust.map((t) => (
        <li>
          <a class="co-link" href={`${base}${t.href}`}>
            <span class="co-link-t">{t.label}</span>
            <span class="co-link-d">{t.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </ProductSection>

  <ProductSection id="press" eyebrow="Press" heading="Press kit" lede={`Boilerplate, fast facts and brand assets for media. For interviews or detail, email ${hello}.`}>
    <div class="co-press">
      <div class="co-bp" data-boilerplate>
        <div class="co-bp-h">
          <h3>Boilerplate</h3>
          <button type="button" class="btn btn-outline co-copy" data-copy-target="boilerplate-text" hidden>Copy boilerplate</button>
        </div>
        <p id="boilerplate-text">{BOILERPLATE}</p>
        <p class="co-copied" role="status" data-copy-status></p>
      </div>
      <div class="co-ff">
        <h3>Fast facts</h3>
        <FactList items={fastFacts} label="Fast facts" />
      </div>
    </div>

    <h3 class="co-sub">Logos and images</h3>
    <p class="co-note">Logos and social images for media use. Please use the files as they are: don't recolor, distort or add effects.</p>
    <ul class="co-assets" role="list">
      {BRAND_ASSETS.map((a) => (
        <li>
          <a class="co-asset" href={`${base}${a.href}`} download>
            <span class="co-asset-n">{a.name}</span>
            <span class="co-asset-d">{a.detail}</span>
          </a>
        </li>
      ))}
    </ul>
  </ProductSection>

  <ProductSection id="careers" eyebrow="Careers" heading="No open roles right now.">
    <p class="co-careers">
      There is nothing to apply for at the moment. If you would like to introduce yourself anyway, email
      <a href={`mailto:${hello}`}>{hello}</a>. {REPLY_LINE}
    </p>
  </ProductSection>

  <PageCTA heading="See it on your own domain." body="Run a free domain scan with no signup, or book a demo and we'll walk through your brands." />
</ProductPage>

<style>
  .co-more { margin: 0; font-size: 14px; color: var(--text-secondary); }
  .co-more a, .co-careers a, .co-note a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .co-more a:hover, .co-careers a:hover { border-bottom-color: var(--accent); }

  .co-routes { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .co-card { display: grid; gap: 8px; align-content: start; min-width: 0; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
  .co-card h3 { margin: 0; font: 700 17px var(--font-display); color: var(--text-primary); }
  .co-card p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .co-mail { font: 600 14px var(--font-mono); color: var(--text-primary); overflow-wrap: anywhere; border-bottom: 1px solid var(--accent); justify-self: start; text-decoration: none; }
  .co-mail:hover { color: var(--accent-hover); }

  /* Trust: 5 links as 3 + 2 on a 6-column grid (the last row stretches), 2 + 2 + 1 then 1 column below. */
  .co-links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .co-links li { grid-column: span 2; min-width: 0; }
  .co-links li:nth-child(n + 4) { grid-column: span 3; }
  .co-link { display: grid; gap: 4px; height: 100%; min-height: 44px; padding: 14px 16px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; text-decoration: none; }
  .co-link:hover { border-color: var(--accent); }
  .co-link-t { font: 700 15px var(--font-display); color: var(--text-primary); }
  .co-link-d { font-size: 13px; line-height: 1.45; color: var(--text-secondary); }

  .co-press { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .co-bp, .co-ff { min-width: 0; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; padding: 16px; display: grid; gap: 12px; align-content: start; }
  .co-bp-h { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; }
  .co-bp h3, .co-ff h3 { margin: 0; font: 700 17px var(--font-display); color: var(--text-primary); }
  .co-bp p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--text-primary); }
  .co-copy { min-height: 44px; font-size: 14px; }
  .co-copy[hidden] { display: none; }
  .co-copied { min-height: 1.2em; font: 600 13px var(--font-mono); color: var(--green-text); }
  .co-sub { margin: 12px 0 0; font: 700 17px var(--font-display); color: var(--text-primary); }
  .co-link-t { display: block; }
  .co-note { margin: 0; font-size: 14px; color: var(--text-secondary); max-width: 62ch; }
  /* Assets: 7 files as 4 + 3 on a 12-column grid. */
  .co-assets { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 10px; }
  .co-assets li { grid-column: span 3; min-width: 0; }
  .co-assets li:nth-child(n + 5) { grid-column: span 4; }
  .co-asset { height: 100%; }
  .co-asset { display: grid; gap: 2px; min-height: 44px; padding: 12px 14px; background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 10px; text-decoration: none; }
  .co-asset:hover { border-color: var(--accent); }
  .co-asset-n { font: 600 14px var(--font-display); color: var(--text-primary); }
  .co-asset-d { font: 500 12px var(--font-mono); color: var(--text-secondary); }
  .co-careers { margin: 0; max-width: 62ch; font-size: 16px; line-height: 1.6; color: var(--text-secondary); }

  @media (max-width: 1000px) { .co-routes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .co-press { grid-template-columns: minmax(0, 1fr); }
    .co-links li, .co-links li:nth-child(n + 4) { grid-column: span 3; }
    .co-links li:last-child { grid-column: 1 / -1; }
    .co-assets li, .co-assets li:nth-child(n + 5) { grid-column: span 6; }
    .co-assets li:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .co-routes { grid-template-columns: minmax(0, 1fr); }
    .co-links li, .co-links li:nth-child(n + 4), .co-links li:last-child { grid-column: 1 / -1; }
  }
</style>

<script>
  // Reveal the copy button only where the Clipboard API exists, so the page
  // never shows a control that cannot work.
  const btn = document.querySelector<HTMLButtonElement>("[data-copy-target]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (btn && status && navigator.clipboard?.writeText) {
    btn.hidden = false;
    btn.addEventListener("click", async () => {
      const src = document.getElementById(btn.dataset.copyTarget ?? "");
      if (!src) return;
      try {
        await navigator.clipboard.writeText((src.textContent ?? "").trim());
        status.textContent = "Copied to clipboard.";
      } catch {
        status.textContent = "Couldn't copy. Select the text and copy it instead.";
      }
    });
  }
</script>
