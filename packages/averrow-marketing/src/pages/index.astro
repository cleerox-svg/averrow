---
/*
 * Homepage. Section 1 redesign (see docs/DISCLOSURE_REGISTER.md rows
 * L4/L10/L12/L13/L17/L21/L22): hero with scan form + an illustrative
 * operation card, a "from the platform" band of real build-time numbers,
 * coverage chips, then how it works / capabilities / console preview /
 * trust / CTA.
 *
 * Every number in the band comes from src/data/stats.json, which
 * scripts/fetch-stats.mjs refreshes from /api/v1/public/stats on each
 * build. Nothing here is "live": the band says when it was last updated.
 * The operation card and the console preview are explicitly labelled
 * illustrative.
 */
import Layout from "../layouts/Layout.astro";
import ByTheNumbers from "../components/ByTheNumbers.astro";
import liveStats from "../data/stats.json";

const stats = liveStats;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// "5 Oct 2026" — UTC so the label doesn't depend on the build machine's zone.
const updated = new Date(stats.generated_at).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

// The register says "40+", never the exact feed count. Fall back to the
// real number if the platform ever reports fewer than 40.
const sources = stats.active_feeds && stats.active_feeds >= 40 ? "40+" : String(stats.active_feeds ?? "");

const bandTiles = [
  { value: stats.threats_detected, label: "threats tracked" },
  { value: stats.campaigns, label: "campaigns tracked" },
  { value: stats.providers_mapped, label: "hosting providers mapped" },
  { value: stats.countries, label: "countries" },
  ...(sources ? [{ value: sources, label: "intelligence sources" }] : []),
];

const coverage = [
  "Lookalike domains",
  "TLS certificates",
  "Social profiles",
  "App stores",
  "Executive impersonation",
  "Dark web",
  "Email authentication",
  "Abuse mailbox",
];

// Illustrative operation graph. Coordinates are in the SVG's 400x190 space.
// tone -> colour token: crit = critical severity, high = high severity,
// amber / blue / green = platform palette.
type Tone = "crit" | "high" | "amber" | "blue" | "green";
const opNodes: Array<{ x: number; y: number; tone: Tone; title: string; sub: string }> = [
  { x: 70, y: 40, tone: "crit", title: "14 domains", sub: "acme-payroll-login.example" },
  { x: 60, y: 120, tone: "high", title: "2 hosting ASNs", sub: "AS64500 · AS64501" },
  { x: 95, y: 168, tone: "amber", title: "1 TLS cert", sub: "shared serial" },
  { x: 330, y: 38, tone: "blue", title: "Social profile", sub: "@acme_hr_support" },
  { x: 345, y: 110, tone: "blue", title: "Cloned app", sub: "\"Acme Pay\"" },
  { x: 305, y: 168, tone: "green", title: "Email", sub: "DMARC p=none" },
];
const toneVar: Record<Tone, string> = {
  crit: "var(--sev-critical)",
  high: "var(--sev-high)",
  amber: "var(--amber)",
  blue: "var(--blue)",
  green: "var(--green)",
};
---

<Layout
  title="Averrow — Digital Risk Protection & Brand Protection"
  description="Averrow finds lookalike domains, fake profiles, cloned apps and phishing kits aimed at your brand and executives, links them to the operation behind them, and files the takedowns. Free 30-second domain scan, no sign-up."
>
  <div class="hero-wrap">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="hero-eyebrow">Brand protection · threat-actor intelligence</div>
      <h1 class="hero-h1" id="hero-title">See <em>who</em> is attacking your brand, and shut them down.</h1>
      <p class="hero-lede">
        Averrow finds lookalike domains, fake profiles, cloned apps and phishing
        kits aimed at your brand and executives. It links them to the
        infrastructure and operation behind them, then files the takedowns.
      </p>
      <p class="hero-lede hero-lede-short">
        Find the fakes, trace the operation behind them, and take them down.
      </p>

      <form class="scan-box" id="scanForm" action={`${base}/assess`} method="POST">
        <label class="sr-only" for="domainInput">Domain to scan for brand threats</label>
        <input
          class="scan-input"
          id="domainInput"
          name="domain"
          type="text"
          inputmode="url"
          placeholder="yourcompany.com"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
        />
        <button class="scan-btn" type="submit" data-cta="hero-scan">Scan your domain <span aria-hidden="true">&rarr;</span></button>
      </form>
      <p class="scan-meta">
        <span>30-second scan &middot; no sign-up</span>
        <span class="scan-meta-dot" aria-hidden="true"></span>
        <span>Plans from $1,499/mo</span>
        <span class="scan-meta-dot" aria-hidden="true"></span>
        <a href={`${base}/demo`} data-cta="hero-demo">Book a demo</a>
      </p>
    </div>

    <figure class="op" aria-labelledby="op-title">
      <div class="op-hd">
        <span class="op-id">OPERATION · EXAMPLE</span>
        <span class="op-tag">Active</span>
      </div>
      <div class="op-title" id="op-title">Payroll-portal phishing kit</div>
      <svg class="op-graph" viewBox="0 0 400 190" role="img" aria-labelledby="op-svg-title op-svg-desc">
        <title id="op-svg-title">Example operation graph</title>
        <desc id="op-svg-desc">
          One operation linking 14 lookalike domains, 2 hosting networks, a shared
          TLS certificate, a fake social profile, a cloned app and a weak email
          authentication record. Illustrative example with names changed.
        </desc>
        <g stroke="var(--border-strong)" stroke-width="1.2" fill="none">
          {opNodes.map(n => <path d={`M200 95 L${n.x} ${n.y}`} />)}
          <path d="M70 40 L25 22" stroke-dasharray="3 3" />
          <path d="M70 40 L32 62" stroke-dasharray="3 3" />
          <path d="M60 120 L22 140" stroke-dasharray="3 3" />
          <path d="M60 120 L28 100" stroke-dasharray="3 3" />
        </g>
        <circle cx="200" cy="95" r="30" fill="var(--sev-critical-bg, rgba(239,68,68,0.10))" stroke="var(--red)" stroke-width="1.5" />
        <text x="200" y="92" text-anchor="middle" class="op-hub-id">OP-2291</text>
        <text x="200" y="105" text-anchor="middle" class="op-hub-sub">19 linked</text>
        {opNodes.map(n => {
          const right = n.x > 200;
          const tx = n.x + (right ? -12 : 12);
          const anchor = right ? "end" : "start";
          return (
            <Fragment>
              <circle cx={n.x} cy={n.y} r="7" fill="var(--bg-secondary)" stroke={toneVar[n.tone]} stroke-width="2" />
              <text x={tx} y={n.y - 1} text-anchor={anchor} class="op-node-title">{n.title}</text>
              <text x={tx} y={n.y + 11} text-anchor={anchor} class="op-node-sub">{n.sub}</text>
            </Fragment>
          );
        })}
        <g fill="var(--sev-critical)" opacity="0.7"><circle cx="25" cy="22" r="3" /><circle cx="32" cy="62" r="3" /></g>
        <g fill="var(--sev-high)" opacity="0.7"><circle cx="22" cy="140" r="3" /><circle cx="28" cy="100" r="3" /></g>
      </svg>
      <div class="op-stats">
        <div><b>9 days</b><span>First seen</span></div>
        <div><b>3</b><span>Surfaces</span></div>
        <div><b>14 &rarr; 6</b><span>Domains live</span></div>
      </div>
      <div class="op-bar">
        <div class="op-bar-row"><span>Takedowns</span><span>8 removed · 4 pending · 2 queued</span></div>
        <div class="op-track" role="img" aria-label="Takedown progress: 8 of 14 removed, 4 pending, 2 queued">
          <i style="width:57%;background:var(--green)"></i>
          <i style="width:29%;background:var(--amber)"></i>
          <i style="width:14%;background:var(--border-strong)"></i>
        </div>
      </div>
      <figcaption class="op-foot">
        <span>Illustrative example · names changed</span>
        <a class="op-link" href={`${base}/resources/sample-operation-report`} data-cta="hero-sample-report">View sample report &rarr;</a>
      </figcaption>
    </figure>
  </section>
  </div>

  <section class="band" aria-label="Platform numbers">
    <div class="band-grid">
      <div class="band-lbl">From the platform · updated {updated}</div>
      {bandTiles.map(t => (
        <div class="band-m"><b>{t.value}</b><span>{t.label}</span></div>
      ))}
    </div>
    <div class="cover" aria-label="What Averrow watches">
      <span class="cover-k">Watches</span>
      <ul class="cover-list">
        {coverage.map(c => <li class="cover-chip">{c}</li>)}
      </ul>
    </div>
  </section>

  <hr class="tr-divider-animated" />

  <section class="squadron">
    <div class="section-label">Automated analysis</div>
    <h2 class="squadron-title">Rule-based correlation. Evidence you can see.</h2>
    <p class="squadron-subtitle">
      Six automated stages cross-reference signals across email, domains,
      social, and threat feeds. Correlation is rule-based and deterministic, so
      every score traces back to the evidence behind it. Behind them, further
      automated processes handle enrichment, infrastructure clustering, social
      discovery, and platform health monitoring.
    </p>
    <div class="agent-grid">
      <div class="agent-card" style="--agent-color: #C83C3C;">
        <svg class="agent-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#C83C3C">
          <circle cx="14" cy="14" r="5"  stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
          <circle cx="14" cy="14" r="11" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity="0.4"/>
          <circle cx="14" cy="14" r="1.5" fill="currentColor"/>
          <line x1="14" y1="14" x2="14" y2="3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="20.5" cy="7.5" r="1.5" fill="#C83C3C" opacity="0.95"/>
        </svg>
        <div class="agent-name">Threat Detection</div>
        <div class="agent-role">Feed &amp; Certificate Monitoring</div>
        <div class="agent-desc">Continuous monitoring across threat feeds and certificate logs</div>
      </div>
      <div class="agent-card" style="--agent-color: #E5A832;">
        <svg class="agent-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#E5A832">
          <path d="M14 3 L25 14 L14 25 L3 14 Z" stroke="currentColor" stroke-width="1.5"/>
          <line x1="14" y1="3"  x2="14" y2="25" stroke="currentColor" stroke-width="1" opacity="0.35"/>
          <line x1="3"  y1="14" x2="25" y2="14" stroke="currentColor" stroke-width="1" opacity="0.35"/>
          <circle cx="14" cy="14" r="3" stroke="currentColor" stroke-width="1.5" opacity="0.6"/>
          <circle cx="14" cy="14" r="1.5" fill="currentColor"/>
        </svg>
        <div class="agent-name">Scoring &amp; Triage</div>
        <div class="agent-role">Composite Exposure Scoring</div>
        <div class="agent-desc">Classifies, scores, and prioritizes threat severity</div>
      </div>
      <div class="agent-card" style="--agent-color: #0A8AB5;">
        <svg class="agent-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#0A8AB5">
          <path d="M2 14 Q14 4 26 14 Q14 24 2 14 Z" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="14" cy="14" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="14" cy="14" r="2"   fill="currentColor"/>
        </svg>
        <div class="agent-name">Takedowns</div>
        <div class="agent-role">Removal Requests</div>
        <div class="agent-desc">Files removal requests with hosts and registrars and tracks each one to resolution</div>
      </div>
      <div class="agent-card" style="--agent-color: #065A78;">
        <svg class="agent-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#065A78">
          <circle cx="14" cy="16" r="10" stroke="currentColor" stroke-width="1.5"/>
          <ellipse cx="14" cy="16" rx="4" ry="10" stroke="currentColor" stroke-width="1" opacity="0.5"/>
          <line x1="4" y1="16" x2="24" y2="16" stroke="currentColor" stroke-width="1" opacity="0.5"/>
          <line x1="14" y1="2"  x2="14" y2="9"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="14" cy="5.5" r="2.5" fill="currentColor"/>
        </svg>
        <div class="agent-name">DNS Resolution</div>
        <div class="agent-role">Infrastructure Resolution</div>
        <div class="agent-desc">Resolves domains to hosts as attackers rotate infrastructure</div>
      </div>
      <div class="agent-card" style="--agent-color: #8A8F9C;">
        <svg class="agent-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#8A8F9C">
          <rect x="2" y="6" width="24" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <polyline points="3,14 6,14 8,9 10.5,18.5 13,11 15,16 17,14 25,14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="23.5" cy="8.5" r="2" fill="#C83C3C" opacity="0.9"/>
        </svg>
        <div class="agent-name">Timeline &amp; Summaries</div>
        <div class="agent-role">Incident Writeups</div>
        <div class="agent-desc">Captures threat timelines and plain-language summaries</div>
      </div>
      <div class="agent-card" style="--agent-color: #3CB878;">
        <svg class="agent-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" style="color:#3CB878">
          <path d="M7 24 Q9 18 13 13 Q17 8 20 4" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2" stroke-linecap="round"/>
          <circle cx="7"  cy="24" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="13" cy="13" r="2"   fill="currentColor" opacity="0.75"/>
          <path d="M17.5 2.5 L20 5.5 L22.5 2.5 L20 0 Z" fill="currentColor"/>
        </svg>
        <div class="agent-name">Geo &amp; Provider Mapping</div>
        <div class="agent-role">Hosting &amp; Regional Mapping</div>
        <div class="agent-desc">Maps resolved infrastructure to provider and region</div>
      </div>
    </div>
  </section>

  <hr class="tr-divider-animated" />

  <section class="how-it-works">
    <div class="section-label">How It Works</div>
    <div class="steps-row">
      <div class="step">
        <div class="step-num">01</div>
        <div class="step-title">Connect your brand</div>
        <div class="step-desc">Enter any domain &mdash; no signup required. We start scanning immediately.</div>
      </div>
      <div class="step-arrow">&rarr;</div>
      <div class="step">
        <div class="step-num">02</div>
        <div class="step-title">We scan everything</div>
        <div class="step-desc">Automated monitoring covers threat feeds, email authentication, domains, certificates, and social platforms.</div>
      </div>
      <div class="step-arrow">&rarr;</div>
      <div class="step">
        <div class="step-num">03</div>
        <div class="step-title">We link the evidence</div>
        <div class="step-desc">Rule-based correlation groups related threats into operations and scores their severity.</div>
      </div>
      <div class="step-arrow">&rarr;</div>
      <div class="step">
        <div class="step-num">04</div>
        <div class="step-title">Takedowns filed</div>
        <div class="step-desc">You get the evidence, the operation behind it, and remediation steps. We file the takedowns.</div>
      </div>
    </div>
  </section>

  <hr class="tr-divider-animated" />

  <section class="capabilities">
    <div class="section-label">Capabilities</div>
    <h2 class="capabilities-title">Full-spectrum brand protection</h2>
    <p class="capabilities-note">Sample output below is illustrative.</p>
    <div class="capabilities-grid">
      <div class="cap-card">
        <svg class="cap-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="16" cy="16" r="2" fill="currentColor"/>
          <circle cx="16" cy="16" r="6" stroke="currentColor" stroke-width="1.5" opacity="0.7"/>
          <circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="1.5" opacity="0.35"/>
          <line x1="16" y1="16" x2="16" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div class="cap-title">Threat Feed Intelligence</div>
        <div class="cap-desc">Continuous scanning across phishing databases, malware feeds, and newly registered domains.</div>
        <div class="cap-mock" aria-label="Sample threat feed output">
          <div class="cap-mock-row"><span class="cap-mock-target">login-yourbrand-mfa.com</span><span class="cap-mock-badge crit">CRIT</span></div>
          <div class="cap-mock-row"><span class="cap-mock-target">yourbrand-support.help</span><span class="cap-mock-badge high">HIGH</span></div>
          <div class="cap-mock-row"><span class="cap-mock-target">yourbrand-billing.app</span><span class="cap-mock-badge high">HIGH</span></div>
        </div>
      </div>

      <div class="cap-card">
        <svg class="cap-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="7" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <polyline points="3,7 13,16 23,7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
        </svg>
        <div class="cap-title">Email Security Posture</div>
        <div class="cap-desc">SPF, DKIM, and DMARC analysis with grading so spoofing is caught at the gate.</div>
        <div class="cap-mock" aria-label="Sample email auth grade">
          <div class="cap-mock-grade">
            <div class="cap-mock-grade-cell"><div class="gl-label">SPF</div><div class="gl-value pass">A</div></div>
            <div class="cap-mock-grade-cell"><div class="gl-label">DKIM</div><div class="gl-value pass">A</div></div>
            <div class="cap-mock-grade-cell"><div class="gl-label">DMARC</div><div class="gl-value fail">F</div></div>
          </div>
        </div>
      </div>

      <div class="cap-card">
        <svg class="cap-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="16" cy="16" rx="13" ry="7" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="16" cy="16" r="4" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
        </svg>
        <div class="cap-title">Social Media Monitoring</div>
        <div class="cap-desc">Fake accounts, handle squatting, and unauthorized brand usage on X, LinkedIn, Instagram, TikTok, GitHub, and YouTube.</div>
        <div class="cap-mock" aria-label="Sample social impersonation match">
          <div class="cap-mock-social">
            <div class="cap-mock-social-avatar">Y</div>
            <div class="cap-mock-social-info">
              <div class="cap-mock-social-handle">@yourbrand_support</div>
              <div class="cap-mock-social-meta">Instagram &middot; 11 days old &middot; no link in bio</div>
            </div>
            <div class="cap-mock-score">94</div>
          </div>
        </div>
      </div>

      <div class="cap-card">
        <svg class="cap-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="13" cy="13" r="8" stroke="currentColor" stroke-width="1.5"/>
          <line x1="19" y1="19" x2="27" y2="27" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <div class="cap-title">Lookalike Domain Detection</div>
        <div class="cap-desc">Fuzzy matching, homoglyph analysis, and newly registered domain monitoring.</div>
        <div class="cap-mock" aria-label="Sample lookalike comparison">
          <div class="cap-mock-diff">
            <div class="cap-mock-diff-line"><div class="cap-mock-diff-label">Real</div><div class="cap-mock-diff-value">yourbrand.com</div></div>
            <div class="cap-mock-diff-line"><div class="cap-mock-diff-label">Match</div><div class="cap-mock-diff-value">y<span class="hi">0</span>urbr<span class="hi">a</span>nd.<span class="hi">co</span></div></div>
            <div class="cap-mock-diff-line"><div class="cap-mock-diff-label">Reg.</div><div class="cap-mock-diff-value">2 days ago &middot; Namecheap</div></div>
          </div>
        </div>
      </div>

      <div class="cap-card">
        <svg class="cap-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="7" y="4" width="18" height="24" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <line x1="11" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="11" y1="14" x2="21" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div class="cap-title">Certificate Transparency</div>
        <div class="cap-desc">Hourly certificate-transparency checks for certificates issued to brand-adjacent domains.</div>
        <div class="cap-mock" aria-label="Sample CT log entry">
          <div class="cap-mock-row"><span class="cap-mock-target">acct.yourbrand.com.io</span><span class="cap-mock-badge high">NEW</span></div>
          <div class="cap-mock-row"><span class="cap-mock-target">Let&rsquo;s Encrypt &middot; 14:07:30Z</span><span class="cap-mock-badge med">ANOM</span></div>
        </div>
      </div>

      <div class="cap-card">
        <svg class="cap-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="4" y="6" width="24" height="20" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <polyline points="4,18 8,18 10,12 13,22 16,14 19,20 21,16 24,16 28,16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="cap-title">Plain-language summaries</div>
        <div class="cap-desc">Readable threat timelines and remediation steps so your team can act fast.</div>
        <div class="cap-mock cap-mock-narrative" aria-label="Sample threat summary">
          &ldquo;Three lookalike domains were registered within 72 hours and share one hosting network and one TLS certificate. They are grouped as a single operation.&rdquo;
          <div class="nm-meta">Illustrative example &middot; automated summary</div>
        </div>
      </div>
    </div>
  </section>

  <hr class="tr-divider-animated" />

  <!-- ── BY THE NUMBERS — real counts + "check it yourself" (Section 2) ── -->
  <ByTheNumbers />

  <hr class="tr-divider-animated" />

  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-headline">Ready to protect your brand?</h2>
      <div class="cta-buttons">
        <a href={`${base}/scan`} class="btn btn-primary" data-cta="run-scan">Scan your domain</a>
        <a href={`${base}/pricing`} class="btn btn-outline" data-cta="view-pricing">View Pricing</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero-wrap { position: relative; isolation: isolate; overflow: hidden; }
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 24px 48px;
  }
  /* Faint grid + amber glow behind the operation card. */
  .hero-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
