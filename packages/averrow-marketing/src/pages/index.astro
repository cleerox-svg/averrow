---
/*
 * Homepage. Section 1 redesign (see docs/DISCLOSURE_REGISTER.md rows
 * L4/L10/L12/L13/L17/L21/L22, §3.13): the G5 H4A operation hero
 * (components/hero/OperationHero.astro, which now tells the OP-2291 story,
 * so the old OperationStory section is gone), a "from the platform" band of
 * real build-time numbers, coverage chips, then the takedown flow /
 * coverage / by-the-numbers / CTA.
 *
 * Every number in the band comes from src/data/stats.json, which
 * scripts/fetch-stats.mjs refreshes from /api/v1/public/stats on each
 * build. Nothing here is "live": the band says when it was last updated.
 * The hero graph is labelled "Fictional example" in every state (H1).
 */
import Layout from "../layouts/Layout.astro";
import ByTheNumbers from "../components/ByTheNumbers.astro";
import OperationHero from "../components/hero/OperationHero.astro";
import Coverage from "../components/Coverage.astro";
import TakedownFlow from "../components/TakedownFlow.astro";
import { COVERAGE } from "../lib/coverage";
import liveStats from "../data/stats.json";

const stats = liveStats;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// "5 Oct 2026" — UTC so the label doesn't depend on the build machine's zone.
const updated = new Date(stats.generated_at).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

// The register says "40+", never the exact feed count. Fall back to the
// real number if the platform ever reports fewer than 40.
const sources = stats.active_feeds && stats.active_feeds >= 40 ? "40+" : String(stats.active_feeds ?? "");

const bandTiles = [
  { value: stats.threats_detected, label: "threats tracked" },
  { value: stats.campaigns, label: "campaigns tracked" },
  { value: stats.providers_mapped, label: "hosting providers mapped" },
  { value: stats.countries, label: "countries" },
  ...(sources ? [{ value: sources, label: "intelligence sources" }] : []),
];

// Names come from the shared source so the chips and the Coverage section match.
const coverage = COVERAGE.map((c) => c.name);
---

<Layout
  title="Averrow — Brand protection that traces the operation"
  description="Find lookalike domains, impersonation accounts and copycat apps aimed at your brand, and file takedowns for lookalike domains and phishing URLs. Free scan, no sign-up."
>
  <OperationHero />

  <section class="band" aria-label="Platform numbers">
    <div class="band-grid">
      <div class="band-lbl">From the platform · updated {updated}</div>
      {bandTiles.map(t => (
        <div class="band-m"><b>{t.value}</b><span>{t.label}</span></div>
      ))}
    </div>
    <div class="cover" aria-label="What Averrow watches">
      <span class="cover-k">Watches</span>
      <ul class="cover-list">
        {coverage.map(c => <li class="cover-chip">{c}</li>)}
      </ul>
    </div>
  </section>

  <hr class="tr-divider-animated" />

  <!-- ── FROM FINDING TO TAKEDOWN — control, in five stages (Section 5) ── -->
  <TakedownFlow />

  <hr class="tr-divider-animated" />

  <!-- ── COVERAGE — the eight surfaces, with plan tags (Section 4) ── -->
  <Coverage />

  <hr class="tr-divider-animated" />

  <!-- ── BY THE NUMBERS — real counts + "check it yourself" (Section 2) ── -->
  <ByTheNumbers />

  <hr class="tr-divider-animated" />

  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-headline">See what's aimed at your brand.</h2>
      <div class="cta-buttons">
        <a href={`${base}/scan`} class="btn btn-primary" data-cta="run-scan">Scan your domain</a>
        <a href={`${base}/pricing`} class="btn btn-outline" data-cta="view-pricing">See plans</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── PLATFORM BAND + COVERAGE ── */
  .band { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg-secondary); }
  .band-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto repeat(5, minmax(0, 1fr));
    align-items: center;
  }
  .band-lbl {
    padding: 16px 22px 16px 24px;
    font: 500 12px var(--font-display);
    letter-spacing: var(--type-label-tracking);
    color: var(--text-secondary);
    border-right: 1px solid var(--border);
    white-space: nowrap;
  }
  .band-m { padding: 14px 18px; border-right: 1px solid var(--border); }
  .band-m:last-child { border-right: 0; }
  .band-m b { display: block; font: 600 20px/1.1 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .band-m span { font-size: 12px; color: var(--text-secondary); }
  .cover {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 0 24px 22px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  .cover-k { font: 500 12px var(--font-display); letter-spacing: var(--type-label-tracking); color: var(--text-secondary); margin-right: 6px; }
  .cover-list { display: contents; list-style: none; }
  .cover-chip {
    list-style: none;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 5px 11px;
  }

  @media (max-width: 1099px) {
    .band-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .band-lbl { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--border); }
  }
  @media (max-width: 959px) {
    .band-lbl { padding: 12px 16px; white-space: normal; }
    .cover { padding: 16px 16px 20px; }
  }
  @media (max-width: 699px) {
    .band-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .band-m { border-bottom: 1px solid var(--border); }
    .band-m:nth-child(even) { border-right: 0; }
    .band-m:last-child { grid-column: 1 / -1; border-bottom: 0; }
  }

  /* ── CTA SECTION ── */
  .cta-section { padding: 3rem 24px; max-width: 1280px; margin: 0 auto; text-align: center; }
  .cta-inner {
    background: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 64px 40px;
    position: relative;
    overflow: hidden;
  }
  .cta-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--primary) 8%, transparent) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-inner::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--primary) 50%, transparent), transparent);
  }
  .cta-headline {
    font-family: var(--font-display);
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    color: var(--text-primary);
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
    line-height: var(--type-section-lh);
    letter-spacing: var(--type-section-tracking);
  }
  .cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  :global([data-theme="light"]) .cta-inner {
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: rgba(226,221,213,0.5);
    box-shadow: 0 4px 24px rgba(0,0,0,0.03), inset 0 1px 0 rgba(255,255,255,0.9);
  }
</style>
