---
/*
 * Homepage. Section 1 redesign (see docs/DISCLOSURE_REGISTER.md rows
 * L4/L10/L12/L13/L17/L21/L22): hero with scan form + an illustrative
 * operation card, a "from the platform" band of real build-time numbers,
 * coverage chips, then the operation story / takedown flow /
 * coverage / by-the-numbers / CTA.
 *
 * Every number in the band comes from src/data/stats.json, which
 * scripts/fetch-stats.mjs refreshes from /api/v1/public/stats on each
 * build. Nothing here is "live": the band says when it was last updated.
 * The operation card and the console preview are explicitly labelled
 * illustrative.
 */
import Layout from "../layouts/Layout.astro";
import ByTheNumbers from "../components/ByTheNumbers.astro";
import OperationStory from "../components/OperationStory.astro";
import Coverage from "../components/Coverage.astro";
import TakedownFlow from "../components/TakedownFlow.astro";
import { COVERAGE } from "../lib/coverage";
import liveStats from "../data/stats.json";

const stats = liveStats;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// "5 Oct 2026" — UTC so the label doesn't depend on the build machine's zone.
const updated = new Date(stats.generated_at).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

// The register says "40+", never the exact feed count. Fall back to the
// real number if the platform ever reports fewer than 40.
const sources = stats.active_feeds && stats.active_feeds >= 40 ? "40+" : String(stats.active_feeds ?? "");

const bandTiles = [
  { value: stats.threats_detected, label: "threats tracked" },
  { value: stats.campaigns, label: "campaigns tracked" },
  { value: stats.providers_mapped, label: "hosting providers mapped" },
  { value: stats.countries, label: "countries" },
  ...(sources ? [{ value: sources, label: "intelligence sources" }] : []),
];

// Names come from the shared source so the chips and the Coverage section match.
const coverage = COVERAGE.map((c) => c.name);

// Illustrative operation graph. Coordinates are in the SVG's 400x190 space.
// tone -> colour token: crit = critical severity, high = high severity,
// amber / blue / green = platform palette.
type Tone = "crit" | "high" | "amber" | "blue" | "green";
const opNodes: Array<{ x: number; y: number; tone: Tone; title: string; sub: string }> = [
  { x: 70, y: 40, tone: "crit", title: "14 domains", sub: "acme-payroll-login.example" },
  { x: 60, y: 120, tone: "high", title: "2 hosting ASNs", sub: "AS64500 · AS64501" },
  { x: 95, y: 168, tone: "amber", title: "1 TLS cert", sub: "shared serial" },
  { x: 330, y: 38, tone: "blue", title: "Social profile", sub: "@acme_hr_support" },
  { x: 345, y: 110, tone: "blue", title: "Cloned app", sub: "\"Acme Pay\"" },
  { x: 305, y: 168, tone: "green", title: "Email", sub: "DMARC p=none" },
];
const toneVar: Record<Tone, string> = {
  crit: "var(--sev-critical)",
  high: "var(--sev-high)",
  amber: "var(--amber)",
  blue: "var(--blue)",
  green: "var(--green)",
};
---

<Layout
  title="Averrow — Digital Risk Protection & Brand Protection"
  description="Averrow finds lookalike domains, fake profiles, cloned apps and phishing kits aimed at your brand and executives, links them to the operation behind them, and files takedowns for lookalike domains and phishing URLs under your authorization. Free 30-second domain scan, no sign-up."
>
  <div class="hero-wrap">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="hero-eyebrow">Brand protection · threat-actor intelligence</div>
      <h1 class="hero-h1" id="hero-title">See <em>who</em> is attacking your brand, and shut them down.</h1>
      <p class="hero-lede">
        Averrow finds lookalike domains, fake profiles, cloned apps and phishing
        kits aimed at your brand and executives. It links them to the
        infrastructure and operation behind them, then files takedowns for lookalike
        domains and phishing URLs under your authorization.
      </p>
      <p class="hero-lede hero-lede-short">
        Find the fakes, trace the operation behind them, and file takedowns.
      </p>

      <form class="scan-box" id="scanForm" action={`${base}/assess`} method="POST">
        <label class="sr-only" for="domainInput">Domain to scan for brand threats</label>
        <input
          class="scan-input"
          id="domainInput"
          name="domain"
          type="text"
          inputmode="url"
          placeholder="yourcompany.com"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          required
        />
        <button class="scan-btn" type="submit" data-cta="hero-scan">Scan your domain <span aria-hidden="true">&rarr;</span></button>
      </form>
      <p class="scan-meta">
        <span>30-second scan &middot; no sign-up &middot; no card</span>
        <span class="scan-meta-dot" aria-hidden="true"></span>
        <a href={`${base}/demo`} data-cta="hero-demo">Book a demo</a>
      </p>
    </div>

    <figure class="op" aria-labelledby="op-title">
      <div class="op-hd">
        <span class="op-id">OPERATION · EXAMPLE</span>
        <span class="op-tag">Active</span>
      </div>
      <div class="op-title" id="op-title">Payroll-portal phishing kit</div>
      <svg class="op-graph" viewBox="0 0 400 190" role="img" aria-labelledby="op-svg-title op-svg-desc">
        <title id="op-svg-title">Example operation graph</title>
        <desc id="op-svg-desc">
          One operation linking 14 lookalike domains, 2 hosting networks, a shared
          TLS certificate, a fake social profile, a cloned app and a weak email
          authentication record. Illustrative example with names changed.
        </desc>
        <g stroke="var(--border-strong)" stroke-width="1.2" fill="none">
          {opNodes.map(n => <path d={`M200 95 L${n.x} ${n.y}`} />)}
          <path d="M70 40 L25 22" stroke-dasharray="3 3" />
          <path d="M70 40 L32 62" stroke-dasharray="3 3" />
          <path d="M60 120 L22 140" stroke-dasharray="3 3" />
          <path d="M60 120 L28 100" stroke-dasharray="3 3" />
        </g>
        <circle cx="200" cy="95" r="30" fill="var(--sev-critical-bg, rgba(239,68,68,0.10))" stroke="var(--red)" stroke-width="1.5" />
        <text x="200" y="92" text-anchor="middle" class="op-hub-id">OP-2291</text>
        <text x="200" y="105" text-anchor="middle" class="op-hub-sub">19 linked</text>
        {opNodes.map(n => {
          const right = n.x > 200;
          const tx = n.x + (right ? -12 : 12);
          const anchor = right ? "end" : "start";
          return (
            <Fragment>
              <circle cx={n.x} cy={n.y} r="7" fill="var(--bg-secondary)" stroke={toneVar[n.tone]} stroke-width="2" />
              <text x={tx} y={n.y - 1} text-anchor={anchor} class="op-node-title">{n.title}</text>
              <text x={tx} y={n.y + 11} text-anchor={anchor} class="op-node-sub">{n.sub}</text>
            </Fragment>
          );
        })}
        <g fill="var(--sev-critical)" opacity="0.7"><circle cx="25" cy="22" r="3" /><circle cx="32" cy="62" r="3" /></g>
        <g fill="var(--sev-high)" opacity="0.7"><circle cx="22" cy="140" r="3" /><circle cx="28" cy="100" r="3" /></g>
      </svg>
      <div class="op-stats">
        <div><b>9 days</b><span>First seen</span></div>
        <div><b>3</b><span>Surfaces</span></div>
        <div><b>14 &rarr; 6</b><span>Domains live</span></div>
      </div>
      <div class="op-bar">
        <div class="op-bar-row"><span>Takedowns</span><span>8 removed · 4 pending · 2 queued</span></div>
        <div class="op-track" role="img" aria-label="Takedown progress: 8 of 14 removed, 4 pending, 2 queued">
          <i style="width:57%;background:var(--green)"></i>
          <i style="width:29%;background:var(--amber)"></i>
          <i style="width:14%;background:var(--border-strong)"></i>
        </div>
      </div>
      <figcaption class="op-foot">
        <span>Illustrative example · names changed</span>
        <a class="op-link" href={`${base}/resources/sample-operation-report`} data-cta="hero-sample-report">View sample report &rarr;</a>
      </figcaption>
    </figure>
  </section>
  </div>

  <section class="band" aria-label="Platform numbers">
    <div class="band-grid">
      <div class="band-lbl">From the platform · updated {updated}</div>
      {bandTiles.map(t => (
        <div class="band-m"><b>{t.value}</b><span>{t.label}</span></div>
      ))}
    </div>
    <div class="cover" aria-label="What Averrow watches">
      <span class="cover-k">Watches</span>
      <ul class="cover-list">
        {coverage.map(c => <li class="cover-chip">{c}</li>)}
      </ul>
    </div>
  </section>

  <hr class="tr-divider-animated" />

  <OperationStory />

  <hr class="tr-divider-animated" />

  <!-- ── FROM FINDING TO TAKEDOWN — control, in five stages (Section 5) ── -->
  <TakedownFlow />

  <hr class="tr-divider-animated" />

  <!-- ── COVERAGE — the eight surfaces, with plan tags (Section 4) ── -->
  <Coverage />

  <hr class="tr-divider-animated" />

  <!-- ── BY THE NUMBERS — real counts + "check it yourself" (Section 2) ── -->
  <ByTheNumbers />

  <hr class="tr-divider-animated" />

  <section class="cta-section">
    <div class="cta-inner">
      <h2 class="cta-headline">Ready to protect your brand?</h2>
      <div class="cta-buttons">
        <a href={`${base}/scan`} class="btn btn-primary" data-cta="run-scan">Scan your domain</a>
        <a href={`${base}/pricing`} class="btn btn-outline" data-cta="view-pricing">See plans</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero-wrap { position: relative; isolation: isolate; overflow: hidden; }
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 24px 48px;
  }
  /* Faint grid + amber glow behind the operation card. */
  .hero-wrap::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 70% 40%, #000 25%, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 70% 40%, #000 25%, transparent 75%);
  }
  .hero-wrap::after {
    content: "";
    position: absolute;
    right: 0;
    top: -15%;
    width: 55%;
    height: 120%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(229, 168, 50, 0.11), transparent);
    pointer-events: none;
  }
  .hero-copy { min-width: 0; }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--amber-text);
    margin-bottom: 18px;
  }
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin-bottom: 18px;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .hero-h1 em { font-style: normal; color: var(--amber-text); }
  .hero-lede {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 54ch;
    margin-bottom: 26px;
  }
  .hero-lede-short { display: none; }

  /* ── SCAN FORM ── */
  .scan-box {
    display: flex;
    max-width: 470px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-secondary);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .scan-box:focus-within {
    border-color: var(--amber);
    box-shadow: 0 0 0 3px var(--accent-bg-strong);
  }
  .scan-input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 16px; /* >=16px stops iOS zooming the page on focus */
    padding: 13px 14px;
    border: none;
    background: transparent;
    color: var(--text-primary);
    outline: none;
  }
  .scan-input::placeholder { color: var(--text-tertiary); }
  .scan-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    white-space: nowrap;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    padding: 13px 18px;
    border: none;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-ink);
    cursor: pointer;
    transition: filter 0.2s;
  }
  .scan-btn:hover { background: var(--btn-primary-bg-hover); }
  .scan-btn:focus-visible { outline: 2px solid var(--text-primary); outline-offset: -4px; }
  .scan-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-secondary);
  }
  .scan-meta a {
    color: var(--text-primary);
    font-weight: 600;
    border-bottom: 1px solid var(--border-strong);
  }
  .scan-meta a:hover { text-decoration: none; border-bottom-color: var(--amber); }
  .scan-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--text-tertiary); }

  /* ── OPERATION CARD ── */
  .op {
    min-width: 0;
    margin: 0;
    background: var(--glass-card-bg);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    padding: 16px 16px 14px;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-lg);
  }
  .op-hd { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
  .op-id { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; color: var(--text-secondary); }
  .op-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sev-critical-text);
    background: var(--sev-critical-bg, rgba(239, 68, 68, 0.10));
    border: 1px solid var(--sev-critical-border, rgba(239, 68, 68, 0.30));
    border-radius: 999px;
    padding: 3px 8px;
  }
  .op-title { font-weight: 700; font-size: 16px; margin: 2px 0 10px; color: var(--text-primary); }
  .op-graph { display: block; width: 100%; height: auto; }
  .op-hub-id { font: 600 9.5px var(--font-mono); fill: var(--sev-critical-text); }
  .op-hub-sub { font: 400 8.5px var(--font-mono); fill: var(--text-secondary); }
  .op-node-title { font: 700 10.5px var(--font-display); fill: var(--text-primary); }
  .op-node-sub { font: 400 8.5px var(--font-mono); fill: var(--text-secondary); }
  .op-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin-top: 10px;
  }
  .op-stats div { background: var(--bg-secondary); padding: 9px 10px; }
  .op-stats b { display: block; font: 700 17px/1.1 var(--font-display); color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .op-stats span { font: 500 10.5px var(--font-mono); color: var(--text-secondary); letter-spacing: 0.04em; text-transform: uppercase; }
  .op-bar { margin-top: 10px; display: grid; gap: 6px; font: 500 11px var(--font-mono); color: var(--text-secondary); }
  .op-bar-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 10px; }
  .op-track { height: 6px; border-radius: 99px; background: var(--border); overflow: hidden; display: flex; }
  .op-track i { display: block; height: 100%; }
  .op-link { color: var(--text-primary); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--border-strong); }
  .op-link:hover { border-bottom-color: var(--accent); }
  .op-foot { margin-top: 10px; font: 500 10.5px var(--font-mono); color: var(--text-secondary); display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }

  /* ── PLATFORM BAND + COVERAGE ── */
  .band { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg-secondary); }
  .band-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: auto repeat(5, minmax(0, 1fr));
    align-items: center;
  }
  .band-lbl {
    padding: 16px 22px 16px 24px;
    font: 600 10.5px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-secondary);
    border-right: 1px solid var(--border);
    white-space: nowrap;
  }
  .band-m { padding: 14px 18px; border-right: 1px solid var(--border); }
  .band-m:last-child { border-right: 0; }
  .band-m b { display: block; font: 800 20px/1.1 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .band-m span { font-size: 12px; color: var(--text-secondary); }
  .cover {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 0 24px 22px;
    border-top: 1px solid var(--border);
    padding-top: 18px;
  }
  .cover-k { font: 600 10.5px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-secondary); margin-right: 6px; }
  .cover-list { display: contents; list-style: none; }
  .cover-chip {
    list-style: none;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 5px 11px;
  }

  @media (max-width: 1099px) {
    .band-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .band-lbl { grid-column: 1 / -1; border-right: 0; border-bottom: 1px solid var(--border); }
  }
  @media (max-width: 959px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding: 32px 16px 28px; gap: 28px; }
    .hero-lede { font-size: 14.5px; }
    .hero-lede-short { display: block; }
    .hero-lede:not(.hero-lede-short) { display: none; }
    .band-lbl { padding: 12px 16px; white-space: normal; }
    .cover { padding: 16px 16px 20px; }
  }
  @media (max-width: 699px) {
    .band-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .band-m { border-bottom: 1px solid var(--border); }
    .band-m:nth-child(even) { border-right: 0; }
    .band-m:last-child { grid-column: 1 / -1; border-bottom: 0; }
  }
  @media (max-width: 479px) {
    .scan-box { flex-direction: column; }
    .scan-input { padding: 13px 14px; }
    .scan-btn { padding: 14px 18px; }
  }

  /* ── CTA SECTION ── */
  .cta-section { padding: 3rem 24px; max-width: 1280px; margin: 0 auto; text-align: center; }
  .cta-inner {
    background: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 64px 40px;
    position: relative;
    overflow: hidden;
  }
  .cta-inner::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(229, 168, 50, 0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .cta-inner::after {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(229, 168, 50, 0.5), transparent);
  }
  .cta-headline {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }
  .cta-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  :global([data-theme="light"]) .cta-inner {
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-color: rgba(226,221,213,0.5);
    box-shadow: 0 4px 24px rgba(0,0,0,0.03), inset 0 1px 0 rgba(255,255,255,0.9);
  }
</style>
