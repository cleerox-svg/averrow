---
/*
 * Contact (Section 9B). The shared ContactForm plus the four real mailboxes.
 * The form POSTs to /api/contact (Worker). No response-time promise
 * (docs/DISCLOSURE_REGISTER.md L35): the only line is "We'll reply by email."
 * Security reports go to security@, not the form (L46).
 */
import ProductPage from "../components/product/ProductPage.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { CONTACT_ROUTES, LEGAL_ENTITY, REPLY_LINE } from "../lib/company";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<ProductPage
  title="Contact — Averrow"
  description="Contact Averrow: send a message, or email sales, support, security or privacy directly."
>
  <ProductHero
    eyebrow="Contact"
    plan={null}
    title="Get in touch."
    sub={`Send us a message, or write to the address that fits. ${REPLY_LINE}`}
  />

  <div class="ct">
    <section class="ct-form" aria-labelledby="ct-form-h">
      <h2 id="ct-form-h">Send a message</h2>
      <ContactForm variant="contact" />
    </section>

    <aside class="ct-side" aria-labelledby="ct-side-h">
      <h2 id="ct-side-h">Or email us directly</h2>
      <div class="ct-card">
      <ul role="list">
        {CONTACT_ROUTES.map((r) => (
          <li>
            <span class="ct-l">{r.label}</span>
            <a href={`mailto:${r.email}`}>{r.email}</a>
            <span class="ct-d">{r.text}</span>
          </li>
        ))}
      </ul>
      <p class="ct-f">
        Averrow is operated by {LEGAL_ENTITY}, a Canadian company. More on the <a href={`${base}/company`}>Company page</a>.
      </p>
      </div>
    </aside>
  </div>
</ProductPage>

<style>
  .ct { max-width: 1280px; margin: 0 auto; padding: 40px 24px 64px; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  /* Both columns start with the same h2, so the headings share one top edge and size. */
  .ct h2 { margin: 0 0 14px; font: 800 24px/1.15 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); }
  .ct-form, .ct-side { min-width: 0; }
  .ct-card { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
  .ct-side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .ct-side li { display: grid; gap: 2px; }
  .ct-l { font: 600 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary); }
  .ct-side li a { font: 600 15px var(--font-mono); color: var(--text-primary); overflow-wrap: anywhere; text-decoration: none; border-bottom: 1px solid var(--accent); justify-self: start; }
  .ct-side li a:hover { color: var(--accent-hover); }
  .ct-d { font-size: 14px; line-height: 1.5; color: var(--text-secondary); }
  .ct-f { margin: 18px 0 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .ct-f a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  @media (max-width: 900px) { .ct { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 16px 48px; } }
</style>
