---
/*
 * /platform/campaign-intelligence (Section 8, phase 2A, Enterprise). Built on
 * the product-page kit in src/components/product/.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md rows L25, L33, §3.5, §3.9):
 *  - Claims only what customers get: an alert when a significant campaign or a
 *    known actor targets their brand; each threat shows the campaign it belongs
 *    to; actor links come from public reporting.
 *  - Clustering signals are named no further than "shared certificates and
 *    hosting". No "registrar" or "registration pattern", no lane names, no
 *    thresholds, no cadence.
 *  - Nothing about noticing or alerting when an operation moves (staff-only,
 *    G27), and no actor "infrastructure rows" (no runtime writer).
 *  - Only domain and IP threats are linked: social, app, leak-site and
 *    executive findings are not (said in the scope table).
 *  - The takedown consent line is kept.
 * The cluster graph is illustrative: fictional brand Acme, `.example` domains.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import StepList from "../../components/product/StepList.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import ProofStrip from "../../components/product/ProofStrip.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow, ScopeRow, Step } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

/** Illustrative graph: four look-alike domains, two shared things, one operation. */
const domains = [
  { label: "acme-login.example", y: 30 },
  { label: "acme-pay.example", y: 100 },
  { label: "acrne.example", y: 170 },
  { label: "acme-help.example", y: 240 },
];
const BOX_W = 138;
const BOX_H = 32;
const cert = { x: 168, y: 58, w: 86, h: 58 };
const host = { x: 168, y: 154, w: 86, h: 58 };
const op = { x: 276, y: 105, w: 64, h: 70 };
// Which domains share which hub.
const certLinks = [0, 1, 2];
const hostLinks = [2, 3];

const steps: Step[] = [
  {
    title: "Record",
    text: "Every new threat is recorded with the certificates and hosting behind it.",
    output: {
      label: "Sample recorded threats",
      rows: [
        { text: "acme-login.example", mono: true, status: "Certificate and hosting recorded", pill: "Recorded", tone: "low" },
        { text: "acme-pay.example", mono: true, status: "Certificate and hosting recorded", pill: "Recorded", tone: "low" },
      ],
    },
  },
  {
    title: "Link",
    text: "Threats that share certificates or hosting are connected into one operation, instead of being logged as unrelated.",
    output: {
      label: "Sample linked threats",
      rows: [
        { text: "acme-login.example", mono: true, status: "Shares a certificate with acme-pay.example", pill: "Linked", tone: "new" },
        { text: "acrne.example", mono: true, status: "Shares hosting with acme-help.example", pill: "Linked", tone: "new" },
      ],
      note: "four domains, one operation",
    },
  },
  {
    title: "Name",
    text: "Where public reporting names the actor behind infrastructure we've clustered, we link it. If the evidence doesn't support a name, we don't give one.",
    output: {
      label: "Sample actor link",
      rows: [{ text: "Operation 4821", status: "An actor named in public reporting", pill: "Public report", tone: "low" }],
    },
  },
];

const youGetRows: SampleRow[] = [
  { text: "A significant campaign is targeting Acme", status: "Alert, with the campaign it belongs to", pill: "Campaign alert", tone: "high" },
  { text: "A known threat actor is targeting Acme", status: "Alert, with the actor from public reporting", pill: "Actor alert", tone: "high" },
  { text: "acme-login.example", mono: true, status: "Shows the campaign this threat belongs to", pill: "Campaign 4821", tone: "low" },
];

const scope: ScopeRow[] = [
  {
    area: "Which threats",
    covered: "Look-alike domains and other domain and IP threats against your brand.",
    notCovered: "Social accounts, apps, leak-site mentions and executive findings are not linked into operations.",
  },
  {
    area: "How they're linked",
    covered: "Shared certificates and hosting.",
    notCovered: "A guarantee that every related domain is found. Infrastructure we can't see isn't linked.",
  },
  {
    area: "Alerts",
    covered: "You are alerted when a significant campaign or a known threat actor targets your brand.",
    notCovered: "An alert for every campaign. Only significant ones, or ones tied to a known actor, reach you.",
  },
  {
    area: "On each threat",
    covered: "The campaign it belongs to, shown with the threat.",
    notCovered: "A full operation map in the console. Today you see the campaign link on each threat.",
  },
  {
    area: "Actors",
    covered: "Where public reporting names the actor behind clustered infrastructure, we link it.",
    notCovered: "Naming who is behind an operation when public reporting doesn't.",
  },
  {
    area: "Removal",
    covered: "Takedowns for look-alike domains and phishing URLs, under an authorization you sign.",
    notCovered: "Filing anything without your approval or your signed rules.",
  },
];
---

<ProductPage
  title="Campaign Intelligence — Averrow"
  description="Averrow links look-alike domains that share certificates and hosting into one operation, so you see the campaign behind each alert."
  crumb="Campaign intelligence"
>
  <ProductHero
    eyebrow="Campaign intelligence"
    plan="enterprise"
    title="See the operation, not just the symptom."
    sub="Attackers reuse certificates and hosting. We link the look-alike domains that share them into one operation, so you see the campaign behind each alert."
  >
    <SampleFrame slot="sample" label="Sample operation graph">
      <figure class="cmp-fig">
        <svg
          class="cmp-svg"
          viewBox="-2 -2 344 284"
          role="img"
          aria-labelledby="cmp-g-title cmp-g-desc"
        >
          <title id="cmp-g-title">Four look-alike domains linked into one operation</title>
          <desc id="cmp-g-desc">
            Illustrative graph. Acme-login, acme-pay and acrne share one certificate. Acrne and acme-help share hosting. Because the two shared items overlap on acrne, all four domains are linked into one operation.
          </desc>

          <g class="cmp-edges" aria-hidden="true">
            {certLinks.map((i) => (
              <line x1={BOX_W} y1={domains[i]!.y + BOX_H / 2} x2={cert.x} y2={cert.y + cert.h / 2} />
            ))}
            {hostLinks.map((i) => (
              <line x1={BOX_W} y1={domains[i]!.y + BOX_H / 2} x2={host.x} y2={host.y + host.h / 2} />
            ))}
            <line class="out" x1={cert.x + cert.w} y1={cert.y + cert.h / 2} x2={op.x} y2={op.y + op.h / 2} />
            <line class="out" x1={host.x + host.w} y1={host.y + host.h / 2} x2={op.x} y2={op.y + op.h / 2} />
          </g>

          {domains.map((d) => (
            <g class="cmp-dom">
              <rect x="0" y={d.y} width={BOX_W} height={BOX_H} rx="8" />
              <text x={BOX_W / 2} y={d.y + BOX_H / 2 + 4} text-anchor="middle">{d.label}</text>
            </g>
          ))}

          <g class="cmp-hub">
            <rect x={cert.x} y={cert.y} width={cert.w} height={cert.h} rx="10" />
            <text x={cert.x + cert.w / 2} y={cert.y + 25} text-anchor="middle">Shared</text>
            <text x={cert.x + cert.w / 2} y={cert.y + 43} text-anchor="middle">certificate</text>
          </g>
          <g class="cmp-hub">
            <rect x={host.x} y={host.y} width={host.w} height={host.h} rx="10" />
            <text x={host.x + host.w / 2} y={host.y + 25} text-anchor="middle">Shared</text>
            <text x={host.x + host.w / 2} y={host.y + 43} text-anchor="middle">hosting</text>
          </g>

          <g class="cmp-op">
            <rect x={op.x} y={op.y} width={op.w} height={op.h} rx="12" />
            <text x={op.x + op.w / 2} y={op.y + 30} text-anchor="middle">One</text>
            <text x={op.x + op.w / 2} y={op.y + 48} text-anchor="middle">operation</text>
          </g>
        </svg>
        <figcaption>
          Four look-alike domains, linked through a shared certificate and shared hosting, resolve to one operation.
        </figcaption>
      </figure>
    </SampleFrame>
  </ProductHero>

  <ProofStrip stats={["operations", "threats"]} />

  <ProductSection
    id="how-it-works"
    eyebrow="How it works"
    heading="Record, link, name."
    lede="Domains get taken down and new ones appear. The certificates and hosting behind them are slower to change, and that reuse is the signal."
  >
    <StepList steps={steps} where="campaign" />
  </ProductSection>

  <ProductSection
    id="what-you-get"
    eyebrow="What you get"
    heading="Alerts and a campaign on every threat."
    lede="You don't learn a new dashboard. The campaign shows up where your team already works, and the alerts reach you when it matters."
  >
    <div class="cmp-get">
      <SampleFrame label="Sample campaign alerts and threat" rows={youGetRows} />
      <ul class="cmp-facts" role="list">
        <li><b>Alerts that matter.</b> You're alerted when a significant campaign or a known threat actor targets your brand.</li>
        <li><b>The campaign on each threat.</b> Every linked threat shows the campaign it belongs to.</li>
        <li><b>Actors from public reporting.</b> Where reporting names the actor, we show it. We don't guess.</li>
      </ul>
    </div>
  </ProductSection>

  <ProductSection
    id="takedowns"
    eyebrow="From pattern to action"
    heading="Takedowns, under your authorization."
  >
    <p class="cmp-consent">
      Takedowns for look-alike domains and phishing URLs run under an authorization you sign and control, within limits you set, at the automation level you choose: manual, semi-automatic with your approval, or automatic. Nothing is filed without your approval or your signed rules, and you can revoke the authorization at any time.
      <a href={`${base}/platform/takedowns`}>See how takedowns work</a>.
    </p>
  </ProductSection>

  <ProductSection
    id="scope"
    eyebrow="Scope"
    heading="What's covered, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="Campaign intelligence: covered and not covered" />
  </ProductSection>

  <RelatedSurfaces
    current="/platform/campaign-intelligence"
    include={["/platform/lookalike-domains", "/platform/threat-detection", "/platform/takedowns"]}
    heading="Campaign intelligence builds on the rest of the platform"
  />

  <PageCTA heading="See the operation behind your alerts." body="Campaign intelligence is part of the Enterprise plan. Book a demo and we'll show it running against your own brand." />
</ProductPage>

<style>
  .cmp-fig { margin: 0; display: grid; gap: 10px; }
  .cmp-svg { display: block; width: 100%; height: auto; max-width: 440px; margin: 0 auto; }
  .cmp-fig figcaption { font-size: 13px; line-height: 1.5; color: var(--text-secondary); }

  .cmp-edges line { stroke: var(--text-tertiary); stroke-width: 1.5; }
  .cmp-edges line.out { stroke: var(--accent); stroke-width: 2; }
  .cmp-dom rect { fill: var(--bg-primary); stroke: var(--border-strong); stroke-width: 1; }
  .cmp-dom text { font: 500 12px var(--font-mono); fill: var(--text-primary); }
  .cmp-hub rect { fill: var(--accent-bg); stroke: var(--accent); stroke-width: 1.5; }
  .cmp-hub text { font: 600 12px var(--font-display); fill: var(--text-primary); }
  .cmp-op rect { fill: var(--accent-bg-strong); stroke: var(--accent); stroke-width: 2; }
  .cmp-op text { font: 700 12px var(--font-display); fill: var(--text-primary); }

  .cmp-get { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .cmp-facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; min-width: 0; }
  .cmp-facts li { font-size: 14.5px; line-height: 1.55; color: var(--text-secondary); padding-left: 14px; border-left: 2px solid var(--accent); }
  .cmp-facts b { color: var(--text-primary); font-weight: 700; }

  .cmp-consent { margin: 0; max-width: 70ch; font-size: 15px; line-height: 1.65; color: var(--text-secondary); background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
  .cmp-consent a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .cmp-consent a:hover { border-bottom-color: var(--accent); }

  @media (max-width: 800px) { .cmp-get { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
</style>
