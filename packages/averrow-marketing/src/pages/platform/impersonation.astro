---
/*
 * /platform/impersonation (Section 8, phase 2A). Built on the product-page kit
 * in src/components/product/. Replaces the old Social Media Monitoring page.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md rows L26, L27, L31, §3.3, §3.9):
 *  - Social: six named networks, auto-discovery of official accounts, handles
 *    an impersonator would likely register, official handles excluded. Checks
 *    are handle-only: no display-name matching and no photo, bio or follower
 *    analysis (said honestly). No threshold, suffix list or probe method.
 *  - Executives: X, Instagram, TikTok, GitHub and YouTube only. Not LinkedIn
 *    (company pages only), not paste or leak-site mentions. Deterministic, no
 *    photo data. A flag is never called a "fake profile" as fact.
 *  - Apps: Apple App Store only; no icon or image matching.
 *  - Trademark: a view built from the other monitors, not a detection source.
 *  - No evidence-package claim: "handle, platform, profile link, when we found
 *    it and why it was flagged" is the approved phrasing (L27).
 * Samples: fictional brand Acme, `.example` domains only.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import StepList from "../../components/product/StepList.astro";
import FactList from "../../components/product/FactList.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import { SOCIAL_NETWORKS } from "../../lib/coverage";
import type { SampleRow, ScopeRow, Step } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const heroRows: SampleRow[] = [
  { text: "@acme_support", mono: true, status: "On X. Handle built from your brand name plus a support word. Found today.", pill: "Likely impersonation", tone: "high" },
  { text: "@acmme", mono: true, status: "On TikTok. One letter off your brand name.", pill: "Possible", tone: "med" },
  { text: "@acmehq", mono: true, status: "On Instagram. Your official account, set aside.", pill: "Official", tone: "ok" },
];

const steps: Step[] = [
  {
    title: "Find your accounts",
    text: "We discover your real brand accounts from your company website. Anything on that list is set aside and never flagged.",
    output: {
      label: "Sample official accounts",
      rows: [
        { text: "@acme", mono: true, status: "X, found on your website", pill: "Official", tone: "ok" },
        { text: "@acmehq", mono: true, status: "Instagram, found on your website", pill: "Official", tone: "ok" },
      ],
      note: "set aside from every check",
    },
  },
  {
    title: "Check the handles",
    text: "On each network we look for accounts at the handles an impersonator would likely register for your brand name, and flag the ones that aren't yours.",
    output: {
      label: "Sample handle checks",
      rows: [
        { text: "@acme_support", mono: true, status: "X, brand name plus a common word", pill: "Likely impersonation", tone: "high" },
        { text: "@acmme", mono: true, status: "TikTok, one letter off", pill: "Possible", tone: "med" },
        { text: "@acme-careers", mono: true, status: "GitHub, brand name plus a common word", pill: "Possible", tone: "med" },
      ],
    },
  },
  {
    title: "Report it",
    text: "Each flagged account comes with the handle, platform, profile link, when we found it and why it was flagged, ready to attach to a platform report.",
    output: {
      label: "Sample flagged account",
      rows: [{ text: "@acme_support", mono: true, status: "Profile link, found today, reason attached", pill: "Ready to report", tone: "new" }],
    },
  },
];

const execFacts = [
  { lead: "Five networks.", text: "X, Instagram, TikTok, GitHub and YouTube." },
  { lead: "Official handles excluded.", text: "Anything an executive actually owns is set aside." },
  { lead: "Fully deterministic.", text: "No photo or biometric data is collected or compared." },
  { lead: "You make the call.", text: "A flag means an account exists at a name-based handle. It could be a namesake, so we show it to you rather than calling it fake." },
];
const appFacts = [
  { lead: "Apple App Store only.", text: "Google Play and other stores are not covered." },
  { lead: "Your apps are set aside.", text: "Official apps and your developer account aren't flagged." },
  { lead: "No icon matching.", text: "We don't compare icons or images today." },
];
const tmFacts = [
  { lead: "Built from the monitors you already have.", text: "Lookalike domains, social accounts and apps, side by side." },
  { lead: "Your marks on file.", text: "Register the names and marks you want read against." },
  { lead: "Not a separate scan.", text: "No image matching, marketplaces or trademark-office watches." },
];

const execRows: SampleRow[] = [
  { text: "@jordanrivera_acme", mono: true, status: "On Instagram. Handle built from the name of Jordan Rivera, CFO. Not an official handle.", pill: "Review", tone: "med" },
  { text: "@jordanrivera", mono: true, status: "On X. Official handle you registered, set aside.", pill: "Official", tone: "ok" },
];

const appRows: SampleRow[] = [
  { text: "Acme Rewards Wallet", status: "Uses your name. The developer isn't yours.", pill: "Copycat", tone: "high" },
  { text: "Acme", status: "Your official app and developer, set aside.", pill: "Official", tone: "ok" },
];

const tmRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "From lookalike domains", pill: "High", tone: "high" },
  { text: "@acme_support on X", status: "From fake profiles", pill: "Likely impersonation", tone: "high" },
  { text: "Acme Rewards Wallet", status: "From App Store monitoring", pill: "Copycat", tone: "high" },
];

const scope: ScopeRow[] = [
  {
    area: "Networks",
    covered: "X, LinkedIn, Instagram, TikTok, GitHub and YouTube, for your brand accounts.",
    notCovered: "Any other network, including Facebook.",
  },
  {
    area: "Your accounts",
    covered: "Official accounts are discovered from your website and are never flagged.",
    notCovered: "Official accounts that aren't on your website may be flagged until they are added.",
  },
  {
    area: "What we look at",
    covered: "Handles: whether an account exists at a handle an impersonator would likely register.",
    notCovered: "Photos, bios, follower counts or posts. A flag is a likelihood, and you decide what to act on.",
  },
  {
    area: "Executives",
    covered: "Name-based handles on X, Instagram, TikTok, GitHub and YouTube. Fully deterministic, with no photo data.",
    notCovered: "Paste-site or leak-site mentions of executives, and personal profiles on networks not listed.",
  },
  {
    area: "App stores",
    covered: "Apps using your name on the Apple App Store, with your official apps set aside.",
    notCovered: "Google Play, other app stores, and icon or image matching.",
  },
  {
    area: "Trademark view",
    covered: "One place that gathers misuse of your name found by the domain, social and app monitors.",
    notCovered: "Image matching, marketplaces, and trademark-office watches.",
  },
  {
    area: "Removal",
    covered: "Removal requests for social accounts and apps are drafted with the details, ready to file with the platform.",
    notCovered: "Filing anything on a platform for you, or without your approval.",
  },
];
---

<ProductPage
  title="Social and Executive Impersonation — Averrow"
  description="Find fake accounts on six social networks, accounts using your executives' names, and copycat apps on the Apple App Store. Each flag comes with the handle, platform, profile link and why it was flagged."
  crumb="Impersonation"
>
  <ProductHero
    surface="social"
    title="Find the accounts pretending to be you."
    sub="We check six social networks for fake accounts using your brand name, watch for your executives' names, and look for copycat apps. You see why each one was flagged."
  >
    <SampleFrame
      slot="sample"
      label="Sample flagged accounts"
      rows={heroRows}
      footer="Handle, platform, profile link, when we found it and why it was flagged"
    />
  </ProductHero>

  <ProductSection
    id="fake-profiles"
    eyebrow="Fake profiles"
    heading="Fake accounts on six networks."
    lede="Attackers don't need to touch your systems to damage your brand. A convincing handle is often enough. We check these networks for accounts that imitate yours."
  >
    <ul class="imp-nets" role="list" aria-label="Networks checked">
      {SOCIAL_NETWORKS.map((n) => <li>{n}</li>)}
    </ul>
    <StepList steps={steps} />
    <p class="imp-note">
      We check handles only. There is no photo, bio or follower analysis, so a flag is a likelihood and you decide what to act on.
    </p>
  </ProductSection>

  <ProductSection
    id="executives"
    eyebrow="Executives"
    heading="Your executives, by name."
    lede="Register an executive once, with their official handles. We check for accounts at handles built from their name."
  >
    <div class="imp-split">
      <FactList items={execFacts} />
      <SampleFrame label="Sample executive findings" rows={execRows} />
    </div>
  </ProductSection>

  <ProductSection
    id="app-stores"
    eyebrow="Cloned apps"
    heading="Copycat apps on the Apple App Store."
    lede="We look for apps using your name on the Apple App Store. Your own apps and developer account are recognised and set aside."
  >
    <div class="imp-split">
      <FactList items={appFacts} />
      <SampleFrame label="Sample app findings" rows={appRows} />
    </div>
  </ProductSection>

  <ProductSection
    id="trademark"
    eyebrow="Trademark · Business and above"
    heading="Misuse of your name, in one view."
    lede="The trademark view gathers what the other monitors find into one place, and you can register your marks. It adds no new detection source."
  >
    <div class="imp-split">
      <FactList items={tmFacts} />
      <SampleFrame label="Sample trademark view" rows={tmRows} />
    </div>
  </ProductSection>

  <ProductSection
    id="scope"
    eyebrow="Scope"
    heading="What's covered, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="Impersonation monitoring: covered and not covered" />
    <p class="imp-more">
      Removal requests follow your rules: <a class="link-u" href={`${base}/platform/takedowns`}>see how takedowns work</a>.
    </p>
  </ProductSection>

  <RelatedSurfaces
    current="/platform/impersonation"
    include={["/platform/lookalike-domains", "/platform/takedowns", "/platform/threat-detection"]}
    heading="Impersonation rarely stops at one channel"
  />

  <PageCTA heading="See who is using your name." body="Run a free domain scan, no signup. Or book a demo and we'll set up social, executive and app monitoring with you." />
</ProductPage>

<style>
  .imp-nets { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .imp-nets li {
    font: 600 13px var(--font-mono);
    color: var(--text-primary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 4px 14px;
  }
  .imp-note { margin: 0; max-width: 62ch; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .imp-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .imp-more { margin: 0; font-size: 14px; color: var(--text-secondary); }
  @media (max-width: 800px) {
    .imp-split { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
</style>
