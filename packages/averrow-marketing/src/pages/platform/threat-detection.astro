---
/*
 * /platform/threat-detection (Section 8, phase 2A). Built on the product-page
 * kit in src/components/product/. Scope: threat feeds, phishing and malware
 * URLs, certificates, and paste-site and ransomware leak-site mentions.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md rows L29-L31, L33, L34, §3.1, §3.4,
 * §3.9):
 *  - No logo matching, no cross-feed de-duplication (it is per source), no
 *    self-serve safe domains (staff add them), no executives on paste or leak
 *    sites, no keyword list, no permutation names, no scoring signals, no
 *    "open phishing-feed community" (say "phishing intelligence sources").
 *  - Look-alike content lives on /platform/lookalike-domains; linked, not repeated.
 *  - Certificates: checked hourly, for customer brands. Never "we watch the stream".
 *  - Dark web = paste sites and ransomware victim lists only. No credential
 *    leaks, forums or markets, no source names.
 *  - "40+ sources" appears once in copy. Every other figure is the dated ProofStrip.
 *  - The sample shows "certificate issued N hours ago" (what a certificate
 *    log can know), never a registration age.
 * Samples: fictional brand Acme, `.example` domains only.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import ProofStrip from "../../components/product/ProofStrip.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow, ScopeRow } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const heroRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "Found by an hourly certificate check", pill: "High", tone: "high" },
];
const facts: Array<[string, string]> = [
  ["Certificate", "Issued 36 hours ago"],
  ["Hosting", "Web server live, mail (MX) records present"],
  ["Name", "Your brand plus words a login page would use"],
];

const certRows: SampleRow[] = [
  { text: "acme-login.example", mono: true, status: "Certificate issued 2 hours ago", pill: "New cert", tone: "new" },
];
const darkRows: SampleRow[] = [
  { text: "Paste mentioning acme.example", status: "Found on a public paste site", pill: "New", tone: "new" },
  { text: "Acme Co on a ransomware victim list", status: "Listed on a leak site", pill: "New", tone: "new" },
];

const scope: ScopeRow[] = [
  {
    area: "Phishing and malware URLs",
    covered: "Reports from phishing intelligence sources and malware URL lists, matched to your domains and brand.",
    notCovered: "Attacks that never appear in a source we read, and the source names themselves.",
  },
  {
    area: "Repeat reports",
    covered: "Repeat reports from a source are collapsed into one record.",
    notCovered: "Merging the same URL reported by different sources into a single alert.",
  },
  {
    area: "Certificates",
    covered: "Certificate-transparency checks every hour, for your brands.",
    notCovered: "Alerts the moment a certificate is issued, and brands you haven't added.",
  },
  {
    area: "Paste sites and ransomware lists",
    covered: "Mentions of your brand and domains on public paste sites and on ransomware victim lists.",
    notCovered: "Leaked credentials, closed forums and marketplaces, and mentions of executives.",
  },
  {
    area: "Your own domains",
    covered: "Tell us your official domains, CDNs and partners and we exclude them.",
    notCovered: "Self-serve allow-listing in the console. Our team adds them for you.",
  },
];
---

<ProductPage
  title="Threat Detection — Averrow"
  description="Phishing and malware URLs, certificates, and paste-site and ransomware leak-site mentions, matched to your brand and scored before they reach you."
  crumb="Threat detection"
>
  <ProductHero
    eyebrow="Threat detection"
    plan={null}
    title="Hear it from us before your customers do."
    sub="We read threat sources and certificate logs, match what they report to your brands, and send you one alert, with the reason, when something clears assessment."
  >
    <SampleFrame slot="sample" label="Sample detection alert" rows={heroRows}>
      <dl class="thd-facts">
        {facts.map(([k, v]) => (
          <div><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
      <div class="thd-why">
        <span>Automated assessment</span>
        <p>A certificate was issued 36 hours ago for a domain that combines your brand name with words a real login page would use. It now has a live web server and mail records, so it can serve a page and handle mail. Suggested next step: draft a takedown.</p>
      </div>
    </SampleFrame>
  </ProductHero>

  <ProofStrip stats={["threats", "providers"]} />

  <ProductSection
    id="feeds"
    eyebrow="Threat sources"
    heading="Phishing and malware URLs, matched to your brand."
    lede="We read 40+ sources. When one names a domain or URL that matches your brand, it becomes a record that is checked and scored before anyone is alerted."
  >
    <ul class="thd-cards" role="list">
      <li>
        <h3>Phishing URLs</h3>
        <p>Live phishing pages reported by phishing intelligence sources, matched to your domains and your brand name.</p>
      </li>
      <li>
        <h3>Malware URLs</h3>
        <p>Malicious payload hosts and download infrastructure from malware URL lists, checked against the same brand matching.</p>
      </li>
      <li>
        <h3>One record, then one alert</h3>
        <p>Repeat reports from a source are collapsed into one record. Anything that clears assessment reaches you with a plain-language reason.</p>
      </li>
    </ul>
  </ProductSection>

  <ProductSection
    id="certificates"
    eyebrow="Certificates"
    heading="Certificates, checked every hour."
    lede="Every hour we check certificate-transparency logs for certificates issued to names that look like your brands. A new certificate often appears before the site does. Look-alike domains themselves are covered on their own page."
  >
    <div class="thd-cert">
      <SampleFrame label="Sample certificate finding" rows={certRows} />
      <p class="thd-more">
        Registrations, character swaps and brand-plus-word domains: <a href={`${base}/platform/lookalike-domains`}>see lookalike domain monitoring</a>.
      </p>
    </div>
  </ProductSection>

  <ProductSection
    id="dark-web"
    eyebrow="Dark web · Business and above"
    heading="Paste sites and ransomware victim lists."
    lede="We check public paste sites and ransomware leak-site victim lists for your brand and domains, so an early sign of a targeted attack reaches you as an alert."
  >
    <div class="thd-cert">
      <SampleFrame label="Sample paste and leak-site findings" rows={darkRows} />
      <p class="thd-more">
        These two source types only. We don't cover leaked credentials, closed forums or marketplaces.
      </p>
    </div>
  </ProductSection>

  <ProductSection
    id="quiet"
    eyebrow="Fewer false alarms"
    heading="Assessed before you hear about it."
    lede="Matching a name is not the same as a threat. Findings are scored on signs of real intent, and low-value noise is dismissed automatically."
  >
    <ul class="thd-cards" role="list">
      <li>
        <h3>Your own domains are set aside</h3>
        <p>Your official domains are recognised automatically. Tell us your CDNs and partners and we exclude them too.</p>
      </li>
      <li>
        <h3>Scored on intent</h3>
        <p>A parked page and a live login page are not treated the same, and the alert says why it was raised.</p>
      </li>
      <li>
        <h3>You decide what happens next</h3>
        <p>Takedowns are drafted for your approval or your signed rules, never filed without them.</p>
      </li>
    </ul>
  </ProductSection>

  <ProductSection
    id="scope"
    eyebrow="Scope"
    heading="What's covered, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="Threat detection: covered and not covered" />
  </ProductSection>

  <RelatedSurfaces
    current="/platform/threat-detection"
    include={["/platform/lookalike-domains", "/platform/takedowns", "/platform/campaign-intelligence"]}
    heading="From detection to action"
  />

  <PageCTA heading="See what's already targeting your brand." body="Run a free domain scan, no signup. Or book a demo and we'll walk through your brands." />
</ProductPage>

<style>
  .thd-facts { margin: 0; display: grid; gap: 8px; }
  .thd-facts div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 10px; font-size: 13px; line-height: 1.45; }
  .thd-facts dt { font: 600 12px var(--font-mono); color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.06em; padding-top: 1px; }
  .thd-facts dd { margin: 0; color: var(--text-primary); min-width: 0; }
  .thd-why { border-top: 1px solid var(--border); padding-top: 12px; display: grid; gap: 6px; }
  .thd-why span { font: 600 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber-text); }
  .thd-why p { margin: 0; font-size: 13.5px; line-height: 1.55; color: var(--text-secondary); }

  .thd-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .thd-cards li { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; padding: 16px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .thd-cards h3 { margin: 0; font: 700 16px var(--font-display); color: var(--text-primary); }
  .thd-cards p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }

  .thd-cert { max-width: 520px; display: grid; gap: 14px; }
  .thd-more { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .thd-more a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .thd-more a:hover { border-bottom-color: var(--accent); }

  @media (max-width: 900px) { .thd-cards { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 420px) { .thd-facts div { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>
