---
/*
 * /platform/email-security (Section 8, phase 2B). Built on the product-page kit
 * in src/components/product/.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L28, L34, §3.2, §3.10): SPF, DKIM and
 * DMARC are checked and combined, with MX, into ONE A+ to F grade. BIMI is a
 * separate readiness check and never changes the grade. DKIM probing says
 * "12+ selectors" and never "per-provider" or "secondary gap" (probing stops at
 * the first selector found). Provider recognition only stops a domain on a major
 * provider being marked unsigned; there is no provider-specific scoring. No grade
 * weights, no per-grade definitions, no per-protocol letters, "VMC validated"
 * never (BIMI certificate is a reachability check). Mirrors
 * packages/averrow-worker/src/email-security.ts and docs/EMAIL_SECURITY_ENGINE.md.
 * Sample: fictional brand Acme, `.example` domains only.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import StepList from "../../components/product/StepList.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow, ScopeRow, Step } from "../../components/product/types";

const heroRows: SampleRow[] = [
  { text: "SPF", status: "Within the DNS lookup limit", pill: "Pass", tone: "ok" },
  { text: "DKIM", status: "Signing found", pill: "Found", tone: "ok" },
  { text: "DMARC", status: "Policy: reject", pill: "Enforcing", tone: "ok" },
  { text: "BIMI", status: "Logo record published, certificate reachable", pill: "Set", tone: "ok" },
];

const steps: Step[] = [
  {
    title: "Read",
    text: "We read your domain's SPF, DMARC and DKIM records and your mail (MX) records. DKIM is probed across 12+ common selectors.",
    output: {
      label: "Sample records read for acme.example",
      rows: [
        { text: "SPF", status: "Hard fail, within the lookup limit", pill: "Pass", tone: "ok" },
        { text: "DMARC", status: "Policy: none", pill: "Monitoring", tone: "med" },
        { text: "DKIM", status: "Signing found", pill: "Found", tone: "ok" },
      ],
    },
  },
  {
    title: "Grade",
    text: "The records combine into one A+ to F grade for the domain. There is one grade, not a letter for each protocol.",
    output: {
      label: "Sample grade for acme.example",
      rows: [{ text: "acme.example", mono: true, status: "One grade for the domain", pill: "B", tone: "med" }],
    },
  },
  {
    title: "Fix",
    text: "Each gap comes with the fix, listed in priority order, so you know what to change first.",
    output: {
      label: "Sample fixes, in priority order",
      rows: [
        { text: "Move DMARC from none to quarantine or reject", status: "Spoofed mail isn't being blocked yet", pill: "First", tone: "high" },
        { text: "Add DMARC aggregate reporting", status: "See who sends as your domain", pill: "Next", tone: "med" },
      ],
    },
  },
];

const scope: ScopeRow[] = [
  {
    area: "One grade",
    covered: "SPF, DKIM, DMARC and your mail records combine into one A+ to F grade, with the fixes listed in priority order.",
    notCovered: "A separate letter for each protocol.",
  },
  {
    area: "SPF",
    covered: "We check that a record exists and flag records likely to break the 10-lookup limit.",
    notCovered: "Following every include to the end of the chain.",
  },
  {
    area: "DMARC",
    covered: "We read the policy (none, quarantine or reject) and whether reporting is set up, because monitor-only is visibility, not protection.",
    notCovered: "Reading your DMARC reports or checking that your mail passes alignment.",
  },
  {
    area: "DKIM",
    covered: "We probe 12+ selectors that major mail and gateway providers use, and look for a signing key.",
    notCovered: "Every selector, or a gap in a second provider's signing. We stop once we find one.",
  },
  {
    area: "Mail provider",
    covered: "We recognise major mail providers and gateways, so a domain on a major provider that uses custom DKIM selectors isn't marked as unsigned.",
    notCovered: "Scoring against each provider's own conventions. The same rules apply to every domain.",
  },
  {
    area: "BIMI",
    covered: "We check whether your logo record is published and your certificate is reachable. BIMI needs DMARC at quarantine or reject, so that is when we look. It is reported separately from the grade.",
    notCovered: "Validating the certificate. We check that it can be reached, not that it is valid.",
  },
];
---

<ProductPage
  title="Email Authentication Grade — Averrow"
  description="One A+ to F grade for your domain from its SPF, DKIM and DMARC checks, with the fixes in priority order and a separate BIMI readiness check."
  crumb="Email security"
>
  <ProductHero
    surface="email"
    title="Know your email grade before an attacker does."
    sub="We check your SPF, DKIM and DMARC records and give your domain one A+ to F grade, with the fixes listed in priority order. We also check BIMI."
  >
    <SampleFrame slot="sample" label="Sample email authentication grade" rows={heroRows} footer="BIMI is reported separately and doesn't change the grade">
      <div class="eg" role="img" aria-label="Sample grade: A+">
        <div class="eg-ring">
          <svg viewBox="0 0 96 96" aria-hidden="true" focusable="false">
            <circle class="eg-track" cx="48" cy="48" r="42" />
            <circle class="eg-fill" cx="48" cy="48" r="42" />
          </svg>
          <div class="eg-in" aria-hidden="true">
            <span class="eg-letter">A+</span>
            <span class="eg-sub">Grade</span>
          </div>
        </div>
        <p class="eg-note">acme.example, one grade for the whole domain</p>
      </div>
    </SampleFrame>
  </ProductHero>

  <ProductSection
    id="how-it-works"
    eyebrow="How it works"
    heading="Read, grade, fix."
    lede="Run it free on any domain, or keep it checked continuously on Professional and above."
  >
    <StepList steps={steps} where="email" />
  </ProductSection>

  <ProductSection
    id="checks"
    eyebrow="What we check"
    heading="What's checked, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="Email authentication: covered and not covered" />
  </ProductSection>

  <ProductSection
    id="whole-picture"
    eyebrow="In context"
    heading="Your email posture is one of the signals."
    lede="We look at lookalikes, impersonation accounts, app listings, leak-site mentions, certificates and your email authentication together, and rate the situation as one."
  />

  <RelatedSurfaces
    current="/platform/email-security"
    include={["/platform/lookalike-domains", "/platform/abuse-mailbox", "/platform/takedowns"]}
    heading="Where spoofing and impersonation meet"
  />

  <PageCTA
    heading="Find out what your email grade is."
    body="Run a free domain scan, no signup. It shows exactly this grade for your domain, and the checks behind it. Or book a demo and we'll walk through the fixes."
  />
</ProductPage>

<style>
  .eg { display: grid; justify-items: center; gap: 10px; padding-top: 14px; border-top: 1px solid var(--border); }
  .eg-ring { position: relative; width: 104px; height: 104px; }
  .eg-ring svg { width: 104px; height: 104px; display: block; }
  .eg-track { fill: none; stroke: color-mix(in srgb, var(--green) 18%, transparent); stroke-width: 6; }
  .eg-fill {
    fill: none;
    stroke: var(--green);
    stroke-width: 6;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: 48px 48px;
    stroke-dasharray: 263.9;
    stroke-dashoffset: 13.2;
  }
  .eg-in { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 2px; }
  .eg-letter { font: 800 32px/1 var(--font-display); color: var(--green-text); }
  .eg-sub { font: 600 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
  .eg-note { margin: 0; font: 500 12px var(--font-mono); color: var(--text-secondary); text-align: center; overflow-wrap: anywhere; }
</style>
