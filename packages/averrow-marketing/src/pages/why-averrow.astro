---
/*
 * Why Averrow (Section 9B). Leads with what a visitor can check without
 * talking to anyone: the free scan, the public status page, the methodology,
 * and how takedowns stay in the customer's control. No customers, logos,
 * testimonials, case studies or partners exist, so none are shown and the page
 * does not make a feature of their absence.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L41, L42, section 3.11): the sample is
 * an illustrative SampleFrame (fictional Acme, `.example` domains) with
 * outcomes only: no scoring-signal names, no registration age, no similarity
 * percentages, no score. Numbers come from ProofStrip. "File takedowns", never
 * "shut down". Principles live on /about only.
 */
import ProductPage from "../components/product/ProductPage.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ProductSection from "../components/product/ProductSection.astro";
import SampleFrame from "../components/product/SampleFrame.astro";
import ProofStrip from "../components/product/ProofStrip.astro";
import FactList from "../components/product/FactList.astro";
import PageCTA from "../components/product/PageCTA.astro";
import type { SampleRow } from "../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const checks = [
  {
    href: "/scan",
    label: "Run the free scan",
    text: "Enter your domain and see your email-authentication grade and how many likely look-alikes are already registered. No signup, no sales call.",
  },
  {
    href: "/status",
    label: "Read the public status page",
    text: "Current service status and incident history, published for anyone to read.",
  },
  {
    href: "/resources/methodology",
    label: "Read how we count",
    text: "What each number we publish counts, over what window, how fresh it is and what it leaves out.",
  },
  {
    href: "/platform/takedowns",
    label: "See how takedowns stay yours",
    text: "Nothing is filed without your approval or your signed rules, and you can withdraw a pending takedown. Providers decide whether to remove content.",
  },
];

const sampleRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "Live website and mail server", pill: "High", tone: "high" },
  { text: "acme-payroll-help.example", mono: true, status: "Registered, no live website yet", pill: "Watch", tone: "med" },
  { text: "@acmecorp_support", mono: true, status: "Handle closely matches the brand name", pill: "Review", tone: "low" },
];

const posture = [
  { lead: "Data processing addendum.", text: "Published, with the sub-processor list." },
  { lead: "SOC 2 Type I.", text: "In preparation. Not yet completed." },
];
---

<ProductPage
  title="Why Averrow — Averrow"
  description="Things you can check yourself before you talk to us: a free domain scan, a public status page, how we count our numbers, and takedowns that stay in your control."
>
  <ProductHero
    eyebrow="Why Averrow"
    plan={null}
    title="Check us before you trust us."
    sub="Four things you can verify yourself, without a call or a signup."
  >
    <SampleFrame
      slot="sample"
      label="Illustrative example of findings for a fictional brand"
      rows={sampleRows}
      footer="Outcomes in plain words. Run the scan to see your own."
    />
  </ProductHero>

  <ProductSection id="verify" eyebrow="Verify" heading="What you can check yourself">
    <ul class="wa-checks" role="list">
      {checks.map((c, i) => (
        <li>
          <a class="wa-check" href={`${base}${c.href}`}>
            <span class="wa-n" aria-hidden="true">{i + 1}</span>
            <span class="wa-t">{c.label}</span>
            <span class="wa-d">{c.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </ProductSection>

  <ProofStrip stats={["threats", "brands", "providers"]} heading="Published numbers" />

  <ProductSection id="posture" eyebrow="Trust" heading="What is in place, and what is not yet">
    <FactList items={posture} label="Trust posture" />
    <p class="wa-links">
      Read the <a href={`${base}/legal/dpa`}>data processing addendum</a>, the <a href={`${base}/security`}>security and trust page</a>,
      or <a href={`${base}/about`}>who is behind Averrow</a>.
    </p>
  </ProductSection>

  <PageCTA heading="Ready to see it on your own brand?" body="Run the free scan first, or book a demo and we'll walk through your brands." />
</ProductPage>

<style>
  .wa-checks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
  .wa-check {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 6px;
    align-items: center;
    height: 100%;
    padding: 16px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
  }
  .wa-check:hover { border-color: var(--accent); }
  .wa-n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    font: 700 13px var(--font-mono);
    color: var(--amber-text);
  }
  .wa-t { font: 700 17px var(--font-display); color: var(--text-primary); }
  .wa-d { grid-column: 1 / -1; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .wa-links { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-secondary); max-width: 64ch; }
  .wa-links a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .wa-links a:hover { border-bottom-color: var(--accent); }
</style>
