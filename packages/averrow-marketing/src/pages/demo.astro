---
/*
 * Demo request (Section 9B). The shared ContactForm in its "demo" variant:
 * adds a required Domain field (sent as `domain`) and drops the Interest
 * select; the POST goes to the same /api/contact. No response-time promise
 * (docs/DISCLOSURE_REGISTER.md L35). The hero omits the CTA pair here because
 * its "Book a demo" button would link to this page; the free scan is offered
 * in the side card instead.
 */
import ProductPage from "../components/product/ProductPage.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ContactForm from "../components/ContactForm.astro";
import FactList from "../components/product/FactList.astro";
import { REPLY_LINE } from "../lib/company";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const expect = [
  { lead: "Your domain.", text: "We start from the domain you give us, and walk through what Averrow watches for it." },
  { lead: "Your rules.", text: "Takedowns are filed only with your approval or under rules you sign." },
];
---

<ProductPage
  title="Book a Demo — Averrow"
  description="Request a guided walkthrough of Averrow on your own domain. Tell us your domain and what you would like to see."
>
  <ProductHero
    eyebrow="Book a demo"
    plan={null}
    cta={false}
    title="See Averrow on your own domain."
    sub={`Tell us your domain and what you would like to see. ${REPLY_LINE}`}
  />

  <div class="dm">
    <section class="dm-form" aria-labelledby="dm-form-h">
      <h2 id="dm-form-h">Request a demo</h2>
      <ContactForm variant="demo" />
    </section>

    <aside class="dm-side" aria-labelledby="dm-side-h">
      <h2 id="dm-side-h">What to expect</h2>
      <FactList items={expect} label="What to expect" />
      <div class="dm-scan">
        <h3>Prefer to look first?</h3>
        <p>The free scan shows your email-authentication grade and how many likely look-alikes are already registered. No signup.</p>
        <a class="btn btn-outline" href={`${base}/scan`} data-cta="demo-scan">Scan your domain</a>
      </div>
    </aside>
  </div>
</ProductPage>

<style>
  .dm { max-width: 1280px; margin: 0 auto; padding: 40px 24px 64px; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .dm h2 { margin: 0 0 14px; font: 800 24px/1.15 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); }
  .dm-form, .dm-side { min-width: 0; }
  .dm-side { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 14px; padding: 20px; display: grid; gap: 4px; }
  .dm-scan { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--border); display: grid; gap: 10px; justify-items: start; }
  .dm-scan h3 { margin: 0; font: 700 17px var(--font-display); color: var(--text-primary); }
  .dm-scan p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .dm-scan .btn { min-height: 44px; }
  @media (max-width: 900px) { .dm { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 28px 16px 48px; } }
</style>
