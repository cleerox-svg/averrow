---
/*
 * /solutions/teams-without-a-soc (Section 9A). Built on the product-page kit
 * in src/components/product/. Replaces /solutions/mid-market (301).
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L40, §3.8 "Alert auto-triage",
 * "Managed SOC handling", §3.11, CLAUDE.md §7 PR-C): triage is rule-based
 * ("low-value noise is dismissed automatically, with the reason recorded"),
 * never a rule, a threshold or "correlates before it alerts". The managed
 * service is sold (owner decision, 2026-10-06). What staff can do on a
 * customer's alerts: acknowledge and triage them (status changes), claim them,
 * and keep their own working notes. What the customer sees: status changes and
 * an assignee shown as "Averrow SOC", and the audit log naming "Averrow SOC".
 * Staff notes are NOT shown to the customer (the tenant view strips every
 * staff_* field), staff are never named, and staff cannot sign or revoke the
 * customer's takedown authorization or create or edit their investigations.
 * Staff never submit a takedown without the customer's approval or signed
 * rules. No response times, no promises of speed, no prices. Samples:
 * fictional brand Acme, `.example` domains only.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import FactList from "../../components/product/FactList.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow, ScopeRow } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const heroRows: SampleRow[] = [
  { text: "acme.example", mono: true, status: "Your own domain, set aside with the reason recorded", pill: "Set aside", tone: "ok" },
  { text: "acme-secure-login.example", mono: true, status: "Serving a login page. Assigned to Averrow SOC.", pill: "High", tone: "high" },
  { text: "Takedown draft", status: "Evidence summary attached", pill: "Awaiting approval", tone: "hold" },
];

const triageFacts = [
  { lead: "Noise is dismissed for you.", text: "Low-value noise is dismissed automatically, with the reason recorded, so your queue holds what needs a decision." },
  { lead: "Your own domains are set aside.", text: "Your official domains are recognised automatically. Tell us your CDNs and partners and we exclude them too." },
  { lead: "Findings arrive with their evidence.", text: "Each alert in your console says what was found and why it was flagged, so a decision doesn't start with research." },
  { lead: "Nothing is filed on its own.", text: "A takedown is drafted and waits for your approval, or is filed under rules you've signed." },
];
const triageRows: SampleRow[] = [
  { text: "acme.example", mono: true, status: "Your official domain. Reason recorded.", pill: "Set aside", tone: "ok" },
  { text: "acme-pay.example", mono: true, status: "Parked, re-checked", pill: "Low", tone: "low" },
  { text: "acme-secure-login.example", mono: true, status: "Serving a login page", pill: "High", tone: "high" },
];

const socFacts = [
  { lead: "Acknowledge and triage.", text: "Our analysts work your alerts from the Averrow console: they acknowledge them, change their status and take them on." },
  { lead: "You see the work.", text: "The status changes show in your console, and an alert they hold is assigned to Averrow SOC. Their audit-log entries read Averrow SOC too. Staff are never named, and their working notes stay internal." },
  { lead: "Takedowns stay yours.", text: "Our analysts never submit a takedown without your authorization: your approval, or rules you've signed. They can't sign or revoke the authorization." },
  { lead: "Your cases stay yours.", text: "Analysts can't create or edit your investigations." },
];
const socRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "Assigned to Averrow SOC", pill: "Acknowledged", tone: "ok" },
  { text: "acme-pay.example", mono: true, status: "Triaged by Averrow SOC", pill: "Triaged", tone: "low" },
  { text: "Takedown draft", status: "Waiting for your approval", pill: "Awaiting approval", tone: "hold" },
];

const scope: ScopeRow[] = [
  {
    area: "Automated triage",
    covered: "Rule-based. Low-value noise is dismissed automatically with the reason recorded, and your official domains are set aside.",
    notCovered: "Rules you write yourself, and a published list of the rules.",
  },
  {
    area: "Averrow SOC",
    covered: "Our analysts acknowledge and triage your alerts. Their work shows in your console, marked Averrow SOC.",
    notCovered: "Named analysts, visible working notes, and promised response or resolution times.",
  },
  {
    area: "Takedowns",
    covered: "Drafted with an evidence summary, and filed only with your approval or under your signed rules.",
    notCovered: "Anything filed without your authorization, and a promise that a provider will remove a site.",
  },
  {
    area: "Your records",
    covered: "Your investigations, takedown requests and authorization stay in your hands.",
    notCovered: "Our analysts creating or editing them, or signing and revoking your authorization.",
  },
  {
    area: "Setup",
    covered: "Our team sets up managed handling with you when you book a demo.",
    notCovered: "A switch in the console. It's arranged with us.",
  },
];
---

<ProductPage
  title="Solutions for Teams Without a SOC — Averrow"
  description="Automated triage takes the first pass on brand threats, and Averrow's analysts can handle your alerts as a service. Every action shows in your console as Averrow SOC."
  crumb="Teams without a SOC"
  parent={{ href: "/solutions", label: "Solutions" }}
>
  <ProductHero
    eyebrow="For teams without a SOC"
    plan={null}
    title="The first pass on brand threats, done for you."
    sub="Averrow triages findings by rule so your queue holds what needs a decision. If you'd rather not work the queue yourself, our analysts can handle your alerts as a service."
  >
    <SampleFrame slot="sample" label="Sample queue for a team without a SOC" rows={heroRows} footer="Nothing is filed without your approval or your signed rules" />
  </ProductHero>

  <ProductSection
    id="triage"
    eyebrow="Automated triage"
    heading="A queue of decisions, not raw alerts."
    lede="Triage runs on every finding before you see it."
  >
    <div class="ts-split">
      <FactList items={triageFacts} label="How automated triage works" />
      <SampleFrame label="Sample triaged queue" rows={triageRows} />
    </div>
  </ProductSection>

  <ProductSection
    id="managed"
    eyebrow="Averrow SOC"
    heading="Or let our analysts work your alerts."
    lede="Our analysts can triage and act on alerts for you. You see every action in your console, marked as Averrow SOC."
  >
    <div class="ts-split">
      <FactList items={socFacts} label="What Averrow analysts can and can't do" />
      <SampleFrame label="Sample alerts handled by Averrow SOC" rows={socRows} footer="Every action shows in your console as Averrow SOC" />
    </div>
    <p class="ts-more">
      Managed handling is arranged with our team. <a class="link-u" href={`${base}/demo`}>Book a demo</a> and ask for it, or see <a class="link-u" href={`${base}/platform/takedowns`}>how takedowns stay under your control</a>.
    </p>
  </ProductSection>

  <ProductSection
    id="scope"
    eyebrow="Scope"
    heading="What's covered, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="Teams without a SOC: covered and not covered" />
  </ProductSection>

  <RelatedSurfaces
    current="/solutions/teams-without-a-soc"
    include={["/platform/lookalike-domains", "/platform/takedowns", "/platform/email-security"]}
    heading="The platform behind this role"
  />
  <RelatedSurfaces
    current="/solutions/teams-without-a-soc"
    source="solutions"
    include={["/solutions/security-teams", "/solutions/fraud-and-customer-trust"]}
    eyebrow="Other roles"
    heading="If you do have analysts"
  />

  <PageCTA heading="Hand over the first pass." body="Run a free domain scan, no signup. Or book a demo and we'll walk through the queue, the triage and managed handling." />
</ProductPage>

<style>
  .ts-split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
  .ts-more { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  @media (max-width: 800px) {
    .ts-split { grid-template-columns: minmax(0, 1fr); gap: 16px; }
  }
</style>
