---
/*
 * /solutions/mssp (Section 9A rewrite; absorbs the true parts of /partners,
 * which now 301s here). Built on the product-page kit.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L37, L38, L47, §3.6, §3.11): the true
 * model is one isolated organisation per client, provisioned by our team (org
 * creation is staff-only), with role-based access and an audit log, and alert
 * and takedown events routed into the MSSP's own SIEM or ticketing tool through
 * webhooks and connectors (Business and Enterprise, set up with our team).
 * One login across several client organisations does not exist (a session
 * binds to one organisation) and is said to be on the roadmap. Everyone in an
 * organisation sees all of its brands. White-label is not available. No
 * "multi-client console", no "data layer", no "add a client without new
 * infrastructure", no Client A-D visual, no email-alert tile, no partner tiers.
 * The closing CTA is "Talk to us about partnering" (/contact) plus the shared
 * Scan/Demo pair. Samples: fictional brand Acme, `.example` domains only.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import StepList from "../../components/product/StepList.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import FactList from "../../components/product/FactList.astro";
import IntegrationList from "../../components/product/IntegrationList.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow, ScopeRow, Step } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const heroRows: SampleRow[] = [
  { text: "Acme organisation", status: "Set up by our team for one client", pill: "Ready", tone: "ok" },
  { text: "Alert raised", status: "Acme organisation, sent to your SIEM", pill: "Routed", tone: "ok" },
  { text: "Takedown status changed", status: "Acme organisation, sent to your ticketing tool", pill: "Routed", tone: "ok" },
];

const steps: Step[] = [
  {
    title: "We set up each client",
    text: "Each client gets its own isolated organisation, with role-based access (viewer, analyst, admin, owner) and an audit log. Our team creates it with you and adds the client's brands.",
    output: {
      label: "Sample client organisation",
      rows: [{ text: "Acme organisation", status: "Provisioned by our team", pill: "Ready", tone: "ok" }],
    },
  },
  {
    title: "Events go to your tools",
    text: "On Business and Enterprise, alert and takedown events from each client organisation go to a webhook, or to Splunk, Microsoft Sentinel, QRadar, Jira or ServiceNow, set up with our team.",
    output: {
      label: "Sample routed events",
      rows: [
        { text: "Alert raised", status: "Acme organisation, sent to your SIEM", pill: "Routed", tone: "ok" },
        { text: "Takedown status changed", status: "Acme organisation, sent to your ticketing tool", pill: "Routed", tone: "ok" },
      ],
    },
  },
  {
    title: "Your process takes over",
    text: "Your analysts triage in the tools they already use. Takedowns follow each client's own authorization: filed only with that client's approval or under rules they've signed.",
    output: {
      label: "Sample takedown draft",
      rows: [{ text: "Takedown draft", status: "Waiting for the client's approval", pill: "Awaiting approval", tone: "hold" }],
    },
  },
];

const availableNow = [
  { lead: "One isolated organisation per client.", text: "Alerts, takedowns and members belong to that client's organisation alone." },
  { lead: "Several brands per client.", text: "One organisation can monitor several of a client's brands. The number is set in the plan with our team." },
  { lead: "Events into your SIEM.", text: "Alert and takedown events from each organisation, routed to the tools you already run." },
  { lead: "STIX 2.1 on request.", text: "Exports of a client's findings, delivered by our team." },
];
const notYet = [
  { lead: "One login across several client organisations.", text: "On the roadmap and not available yet. Today each login belongs to one organisation." },
  { lead: "You can't add clients yourself.", text: "Our team creates each client organisation with you." },
  { lead: "White-label is not available.", text: "Portals and reports carry the Averrow name today." },
  { lead: "One organisation sees all its brands.", text: "Everyone in an organisation sees every brand in it, so keep each client in its own organisation." },
];

const scope: ScopeRow[] = [
  {
    area: "Client organisations",
    covered: "One isolated organisation per client, set up by our team, with role-based access and an audit log.",
    notCovered: "Adding clients yourself, and one login across several client organisations. That one is on the roadmap.",
  },
  {
    area: "Brands",
    covered: "Several brands in one organisation, with the number set in the plan with our team.",
    notCovered: "Limiting which brands a member can see inside an organisation.",
  },
  {
    area: "Into your tools",
    covered: "Alert and takedown events to webhooks and to Splunk, Microsoft Sentinel, QRadar, Jira and ServiceNow, on Business and Enterprise, set up with our team.",
    notCovered: "Connectors you configure yourself in the console, and event types beyond alerts and takedowns.",
  },
  {
    area: "Reporting",
    covered: "STIX 2.1 export of a client's findings, on request, delivered by our team.",
    notCovered: "White-label portals or reports, which are not available today, and an API you query yourself.",
  },
  {
    area: "Takedowns",
    covered: "Drafted with an evidence summary and filed under each client's own authorization.",
    notCovered: "Filing for a client without that client's approval or signed rules.",
  },
  {
    area: "Partnership terms",
    covered: "We shape each partnership with you, and talk it through first.",
    notCovered: "Partner tiers, deal registration or reseller billing. None exist today.",
  },
];
---

<ProductPage
  title="Solutions for MSSPs and Partners — Averrow"
  description="One isolated Averrow organisation per client, set up by our team, with alert and takedown events routed into your own SIEM or ticketing tool. One login across several client organisations is on the roadmap and not available yet."
  crumb="MSSPs and partners"
  parent={{ href: "/solutions", label: "Solutions" }}
>
  <ProductHero
    eyebrow="For MSSPs and partners"
    plan={null}
    title="Brand threat intelligence for your clients, in your own tools."
    sub="Each client gets its own isolated Averrow organisation, set up by our team. Alert and takedown events from each one can flow into your SIEM or ticketing tool."
  >
    <SampleFrame slot="sample" label="Sample client organisation and routed events" rows={heroRows} footer="One organisation per client, set up by our team" />
  </ProductHero>

  <ProductSection
    id="model"
    eyebrow="How it works"
    heading="One organisation per client, events into your tools."
    lede="Averrow sits inside the workflow you already run for each client. It isn't a portal your clients have to learn."
  >
    <StepList steps={steps} />
  </ProductSection>

  <ProductSection
    id="availability"
    eyebrow="What's available"
    heading="Today, and not yet."
    lede="MSSPs ask the same questions first, so here is the plain answer."
  >
    <div class="sol-split">
      <div class="ms-col">
        <h3>Available now</h3>
        <FactList items={availableNow} label="Available now" />
      </div>
      <div class="ms-col">
        <h3>Not available yet</h3>
        <FactList items={notYet} label="Not available yet" />
      </div>
    </div>
  </ProductSection>

  <ProductSection
    id="integrations"
    eyebrow="Your tools"
    heading="Works with the stack you already run."
    lede="Our team sets up each connection with you. Webhooks and the connectors belong to Business and Enterprise."
  >
    <IntegrationList />
  </ProductSection>

  <ProductSection
    id="partnering"
    eyebrow="Partnering"
    heading="Tell us about your clients and your stack."
    lede="We shape each partnership with you. Tell us how many clients, which brands and which tools, and we'll walk through how the organisations, the routing and takedown authorization would work for you."
  />

  <ProductSection
    id="scope"
    eyebrow="Scope"
    heading="What's covered, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="MSSPs and partners: covered and not covered" />
  </ProductSection>

  <RelatedSurfaces
    current="/solutions/mssp"
    include={["/platform/takedowns", "/platform/threat-detection", "/platform/campaign-intelligence"]}
    heading="The platform behind this role"
  />
  <RelatedSurfaces
    current="/solutions/mssp"
    source="solutions"
    include={["/solutions/security-teams", "/solutions/teams-without-a-soc"]}
    eyebrow="Other roles"
    heading="What your clients' teams see"
  />

  <PageCTA heading="Let's talk about partnering." body="Tell us about your clients and your stack. Or run a free domain scan, no signup, or book a demo and we'll show you an organisation and the routing.">
    <a class="btn btn-primary ms-partner" href={`${base}/contact?interest=partnership`} data-cta="mssp-partner">Talk to us about partnering</a>
  </PageCTA>
</ProductPage>

<style>
  .ms-col { display: grid; gap: 12px; min-width: 0; }
  .ms-col h3 { margin: 0; font: 700 17px var(--font-display); color: var(--text-primary); }
  .ms-partner { min-height: 44px; justify-content: center; }
  @media (max-width: 480px) {
    .ms-partner { width: 100%; }
  }
</style>
