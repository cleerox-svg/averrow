---
/*
 * /solutions (Section 9A): the hub, organised by buyer role. Built on the
 * product-page kit. Each card shows a small illustrative sample (a mini
 * SampleRows) rather than an icon and a checklist, so a visitor sees what that
 * role actually looks at.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md §3.11, L14, L15, L37, L38): no prices,
 * no AI, no times, no multi-org console, no white-label, no email-alert
 * delivery. The Abuse Mailbox is labelled Enterprise. Samples: fictional brand
 * Acme, `.example` domains only. Numbers come from ProofStrip only.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleRows from "../../components/product/SampleRows.astro";
import ProofStrip from "../../components/product/ProofStrip.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

interface RoleCard {
  href: string;
  role: string;
  title: string;
  text: string;
  rows: SampleRow[];
  cta: string;
}

const roles: RoleCard[] = [
  {
    href: "/solutions/security-teams",
    role: "Security teams",
    title: "Phishing and lookalikes, into your SIEM.",
    text: "Find lookalike domains and certificates aimed at your brand, triage by rule, and route events to the tools you run.",
    rows: [
      { text: "acme-secure-login.example", mono: true, status: "Serving a login page", pill: "High", tone: "high" },
      { text: "acme-login.example", mono: true, status: "Certificate issued 2 hours ago", pill: "New cert", tone: "new" },
    ],
    cta: "See security teams",
  },
  {
    href: "/solutions/brand-and-legal",
    role: "Brand and legal",
    title: "Fake profiles, copycat apps, executives.",
    text: "Find who is using your name, see it in one trademark view, and file takedowns under your signed authorization.",
    rows: [
      { text: "@acme_support", mono: true, status: "On X. Brand name plus a support word.", pill: "Likely impersonation", tone: "high" },
      { text: "Acme Rewards Wallet", status: "Apple App Store. Uses your name.", pill: "Copycat", tone: "high" },
    ],
    cta: "See brand and legal",
  },
  {
    href: "/solutions/fraud-and-customer-trust",
    role: "Fraud and customer trust",
    title: "Reported phishing, taken down.",
    text: "Give customers one address to report suspicious email (Abuse Mailbox, Enterprise), and draft takedowns for the sites behind it.",
    rows: [
      { text: "Report received", status: "Forwarded by a customer", pill: "Acknowledged", tone: "ok" },
      { text: "Takedown draft", status: "Evidence summary attached", pill: "Awaiting approval", tone: "hold" },
    ],
    cta: "See fraud and customer trust",
  },
  {
    href: "/solutions/teams-without-a-soc",
    role: "Teams without a SOC",
    title: "The first pass, done for you.",
    text: "Automated triage, plus Averrow's analysts handling your alerts as a service, marked as Averrow SOC in your console.",
    rows: [
      { text: "acme.example", mono: true, status: "Your own domain, set aside", pill: "Set aside", tone: "ok" },
      { text: "acme-secure-login.example", mono: true, status: "Assigned to Averrow SOC", pill: "Acknowledged", tone: "ok" },
    ],
    cta: "See teams without a SOC",
  },
  {
    href: "/solutions/mssp",
    role: "MSSPs and partners",
    title: "One organisation per client.",
    text: "Isolated client organisations set up by our team, with alert and takedown events routed into your own SIEM.",
    rows: [
      { text: "Acme organisation", status: "Set up by our team for one client", pill: "Ready", tone: "ok" },
      { text: "Alert raised", status: "Acme organisation, sent to your SIEM", pill: "Routed", tone: "ok" },
    ],
    cta: "See MSSPs and partners",
  },
];
---

<ProductPage
  title="Solutions by Role — Averrow"
  description="Averrow watches the same places for everyone. Choose your role to see what you'd work with: security teams, brand and legal, fraud and customer trust, teams without a SOC, and MSSPs."
>
  <ProductHero
    eyebrow="Solutions"
    plan={null}
    title="Start from the job you do."
    sub="Averrow watches the same places for every team. What changes is what you do with a finding. Choose your role to see it."
  />

  <ProofStrip stats={["brands", "lookalikes", "threats"]} />

  <ProductSection
    id="roles"
    eyebrow="By role"
    heading="Five ways teams use Averrow."
    lede="Each page shows the findings that role works with, what it can send to your tools, and what isn't covered."
  >
    <ul class="sh-grid" role="list">
      {roles.map((r) => (
        <li>
          <a class="sh-card" href={`${base}${r.href}`} data-solution={r.href}>
            <span class="sh-role">{r.role}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
            <div class="sh-sample" role="group" aria-label={`Sample for ${r.role}`}>
              <span class="sh-tag">Illustrative sample</span>
              <SampleRows rows={r.rows} />
            </div>
            <span class="sh-go">{r.cta} <span aria-hidden="true">&rarr;</span></span>
          </a>
        </li>
      ))}
    </ul>
  </ProductSection>

  <PageCTA heading="Not sure which role fits?" body="Run a free domain scan, no signup. Or book a demo and we'll show you the view that fits your team." />
</ProductPage>

<style>
  .sh-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
  .sh-grid li { min-width: 0; }
  .sh-card {
    display: grid;
    gap: 10px;
    align-content: start;
    height: 100%;
    padding: 18px;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }
  .sh-card:hover { border-color: var(--accent); text-decoration: none; }
  .sh-card:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  .sh-role { font: 600 12px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-section, var(--accent)); }
  .sh-card h3 { margin: 0; font: 800 20px/1.2 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); text-wrap: balance; }
  .sh-card p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .sh-sample { display: grid; gap: 10px; padding: 12px; background: var(--bg-primary, var(--bg-secondary)); border: 1px solid var(--border); border-radius: 10px; min-width: 0; }
  .sh-tag { justify-self: start; font: 700 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--amber-text); border: 1px solid var(--amber-text); border-radius: 999px; padding: 1px 9px; }
  .sh-go { font: 700 14px var(--font-display); color: var(--amber-text); }
  @media (max-width: 640px) {
    .sh-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
