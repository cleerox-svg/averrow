---
/*
 * /solutions/brand-and-legal (Section 9A). Built on the product-page kit in
 * src/components/product/. Role page for brand, trademark and legal teams:
 * fake social profiles, executive impersonation, Apple App Store copycats, the
 * trademark view, and takedowns under signed authorization.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L26, L27, L31, L42, §3.3, §3.7,
 * §3.9): six named networks, handle checks only (no photo, bio or follower
 * analysis); executives on X, Instagram, TikTok, GitHub and YouTube with no
 * photo data, and a flag is never called fake as fact; Apple App Store only;
 * the trademark view is built from the other monitors (Business and above) and
 * adds no detection source; evidence is "handle, platform, profile link, when
 * we found it and why it was flagged". Takedowns are filed for lookalike
 * domains and phishing URLs; social and app removals are drafted, ready to file
 * with the platform, never filed for the customer. Nothing is filed without
 * approval or signed rules. Samples: fictional brand Acme, `.example` domains.
 */
import ProductPage from "../../components/product/ProductPage.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import ProductSection from "../../components/product/ProductSection.astro";
import SampleFrame from "../../components/product/SampleFrame.astro";
import SampleRows from "../../components/product/SampleRows.astro";
import ScopeTable from "../../components/product/ScopeTable.astro";
import FactList from "../../components/product/FactList.astro";
import RelatedSurfaces from "../../components/product/RelatedSurfaces.astro";
import PageCTA from "../../components/product/PageCTA.astro";
import type { SampleRow, ScopeRow } from "../../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const heroRows: SampleRow[] = [
  { text: "@acme_support", mono: true, status: "On X. Handle built from your brand name plus a support word. Found today.", pill: "Likely impersonation", tone: "high" },
  { text: "Acme Rewards Wallet", status: "Apple App Store. Uses your name. The developer isn't yours.", pill: "Copycat", tone: "high" },
  { text: "@jordanrivera_acme", mono: true, status: "On Instagram. Handle built from the name of Jordan Rivera, CFO.", pill: "Review", tone: "med" },
];

const watch: Array<{ id: string; title: string; text: string; rows: SampleRow[]; label: string; href: string }> = [
  {
    id: "profiles",
    title: "Fake profiles",
    text: "On X, LinkedIn, Instagram, TikTok, GitHub and YouTube we look for accounts at the handles an impersonator would likely register for your brand name. Your official accounts are set aside. We check handles only, not photos, bios or followers.",
    label: "Sample fake profile finding",
    rows: [{ text: "@acme_support", mono: true, status: "On X. Brand name plus a support word.", pill: "Likely impersonation", tone: "high" }],
    href: "/platform/impersonation#fake-profiles",
  },
  {
    id: "executives",
    title: "Executives",
    text: "Register an executive once, with their official handles. We look for accounts at name-based handles on X, Instagram, TikTok, GitHub and YouTube. No photo data is used, and a flag is shown for your review, not called fake.",
    label: "Sample executive finding",
    rows: [{ text: "@jordanrivera_acme", mono: true, status: "On Instagram. Not an official handle.", pill: "Review", tone: "med" }],
    href: "/platform/impersonation#executives",
  },
  {
    id: "apps",
    title: "Copycat apps",
    text: "We look for apps using your name on the Apple App Store, with your official apps and developer set aside. Google Play isn't covered, and we don't compare icons.",
    label: "Sample app finding",
    rows: [{ text: "Acme Rewards Wallet", status: "Uses your name. The developer isn't yours.", pill: "Copycat", tone: "high" }],
    href: "/platform/impersonation#app-stores",
  },
];

const trademarkRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "From lookalike domains", pill: "High", tone: "high" },
  { text: "@acme_support on X", status: "From fake profiles", pill: "Likely impersonation", tone: "high" },
  { text: "Acme Rewards Wallet", status: "From App Store monitoring", pill: "Copycat", tone: "high" },
];
const trademarkFacts = [
  { lead: "One place.", text: "Lookalike domains, social accounts and apps, side by side." },
  { lead: "Your marks on file.", text: "Register the names and marks you want findings read against." },
  { lead: "Not a separate scan.", text: "It adds no detection source: no image matching, marketplaces or trademark-office watches." },
];

const authFacts = [
  { lead: "You sign it.", text: "Your organisation signs an authorization that sets what Averrow may file for you. You can revoke it at any time." },
  { lead: "Three levels.", text: "Off (you approve each one), Semi-auto (approval for anything outside your rules) and Auto (within your signed scope)." },
  { lead: "Nothing without it.", text: "Our analysts can't submit a takedown without your approval or your signed rules." },
  { lead: "Domains and phishing URLs are filed.", text: "For social accounts and apps, the removal request is drafted with the details, ready to file with the platform. We don't file those for you." },
];

const scope: ScopeRow[] = [
  {
    area: "Social networks",
    covered: "X, LinkedIn, Instagram, TikTok, GitHub and YouTube, for your brand accounts. Official accounts found on your website are never flagged.",
    notCovered: "Any other network, including Facebook, and photos, bios, follower counts or posts.",
  },
  {
    area: "Executives",
    covered: "Name-based handles on X, Instagram, TikTok, GitHub and YouTube for executives you register.",
    notCovered: "LinkedIn, paste-site or leak-site mentions, and proof that an account is fake. A flag is a likelihood.",
  },
  {
    area: "Apps",
    covered: "Apps using your name on the Apple App Store.",
    notCovered: "Google Play, other stores, and icon or image matching.",
  },
  {
    area: "Trademark view",
    covered: "Business and above. The domain, social and app findings in one place, read against the marks you register.",
    notCovered: "Image matching, marketplaces and trademark-office watches.",
  },
  {
    area: "Takedowns",
    covered: "Lookalike domains and phishing URLs are filed under your authorization. Social and app removals are drafted with the details.",
    notCovered: "Filing anything on a social or app platform for you, filing without your approval or signed rules, or a promise of removal.",
  },
];
---

<ProductPage
  title="Solutions for Brand and Legal Teams — Averrow"
  description="Find fake social profiles, accounts using your executives' names and copycat apps on the Apple App Store, see them in one trademark view, and file takedowns under your signed authorization."
  crumb="Brand and legal"
  parent={{ href: "/solutions", label: "Solutions" }}
>
  <ProductHero
    eyebrow="For brand and legal teams"
    plan={null}
    title="Find who is using your name, and what to do next."
    sub="Averrow finds fake profiles on six social networks, accounts using your executives' names and copycat apps, with the evidence for each. Takedowns are filed only under the authorization you sign."
  >
    <SampleFrame slot="sample" label="Sample impersonation findings" rows={heroRows} footer="Handle, platform, profile link, when we found it and why it was flagged" />
  </ProductHero>

  <ProductSection
    id="impersonation"
    eyebrow="What we look for"
    heading="Fake profiles, executives and copycat apps."
    lede="Each flag comes with the handle, platform, profile link, when we found it and why it was flagged. You decide what to act on."
  >
    <ul class="bl-cards" role="list">
      {watch.map((w) => (
        <li class="bl-card" id={w.id}>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
          <div class="bl-out" role="group" aria-label={w.label}>
            <SampleRows rows={w.rows} />
          </div>
          <a class="link-u" href={`${base}${w.href}`}>More on {w.title.toLowerCase()}</a>
        </li>
      ))}
    </ul>
  </ProductSection>

  <ProductSection
    id="trademark"
    eyebrow="Trademark · Business and above"
    heading="Misuse of your name, in one view."
    lede="The trademark view gathers what the other monitors find into one place, for the team that decides what to enforce."
  >
    <div class="sol-split">
      <FactList items={trademarkFacts} label="The trademark view" />
      <SampleFrame label="Sample trademark view" rows={trademarkRows} />
    </div>
  </ProductSection>

  <ProductSection
    id="authorization"
    eyebrow="Authorization"
    heading="Takedowns under your signed authorization."
    lede="Legal sets the scope once. Averrow files within it."
  >
    <FactList items={authFacts} label="How authorization works" />
    <p class="sol-more">
      <a class="link-u" href={`${base}/platform/takedowns`}>See how takedowns work</a>, including every status.
    </p>
  </ProductSection>

  <ProductSection
    id="scope"
    eyebrow="Scope"
    heading="What's covered, and what isn't."
    lede="Every claim on this page has a limit. These are the limits."
  >
    <ScopeTable rows={scope} caption="Brand and legal: covered and not covered" />
  </ProductSection>

  <RelatedSurfaces
    current="/solutions/brand-and-legal"
    include={["/platform/impersonation", "/platform/takedowns", "/platform/lookalike-domains"]}
    heading="The platform behind this role"
  />
  <RelatedSurfaces
    current="/solutions/brand-and-legal"
    source="solutions"
    include={["/solutions/fraud-and-customer-trust", "/solutions/security-teams"]}
    eyebrow="Other roles"
    heading="Where the work gets shared"
  />

  <PageCTA heading="See who is using your name." body="Run a free domain scan, no signup. Or book a demo and we'll set up social, executive and app monitoring with you." />
</ProductPage>

<style>
  .bl-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .bl-card {
    display: grid;
    gap: 12px;
    align-content: start;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    min-width: 0;
    scroll-margin-top: 80px;
  }
  .bl-card h3 { margin: 0; font: 700 17px var(--font-display); color: var(--text-primary); }
  .bl-card p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }
  .bl-out { border-top: 1px solid var(--border); padding-top: 12px; }
  .bl-card a { justify-self: start; font-size: 14px; }
  @media (max-width: 900px) {
    .bl-cards { grid-template-columns: minmax(0, 1fr); }
    }
</style>
