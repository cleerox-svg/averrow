---
/*
 * /platform: the overview (Section 8, phase 1). Replaces the old four-capability
 * page. Shows all eight surfaces (the homepage Coverage grid, so names, plan
 * labels and links come from src/lib/coverage.ts), links to the deep-dive pages,
 * and absorbs the true parts of the retired /platform/ai-agents page under
 * #how-it-works (that URL now redirects here).
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L10, L24, L25, L34, §3.5, §3.6, §3.8):
 * no "AI" wording (prod runs rules-only), no agent counts or codenames, no
 * "notices when it moves" (L25), operations are an Enterprise capability and
 * labelled so, "four signal streams" is never used, and the integrations list
 * uses one status vocabulary with no customer email/push delivery claim (L24).
 * Samples are illustrative, fictional brand Acme, `.example` domains.
 */
import ProductPage from "../components/product/ProductPage.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ProductSection from "../components/product/ProductSection.astro";
import SampleFrame from "../components/product/SampleFrame.astro";
import ProofStrip from "../components/product/ProofStrip.astro";
import RelatedSurfaces from "../components/product/RelatedSurfaces.astro";
import PageCTA from "../components/product/PageCTA.astro";
import Coverage from "../components/Coverage.astro";
import type { SampleRow } from "../components/product/types";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const queueRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "Lookalike domain, serving a login page", pill: "High", tone: "high" },
  { text: "@acme_support", mono: true, status: "Instagram, not your official account", pill: "Likely fake", tone: "high" },
  { text: "“Acme Pay”", status: "App Store, developer is not Acme", pill: "Copycat", tone: "high" },
  { text: "acme.example", mono: true, status: "Email authentication, DMARC missing", pill: "Weak", tone: "med" },
];

const stages = [
  {
    name: "Threat detection",
    role: "Feeds and certificates",
    text: "Watches phishing and malware intelligence, certificate-transparency logs and DNS data, and passes every new hit on for scoring.",
  },
  {
    name: "Scoring and triage",
    role: "How much it matters",
    text: "Weighs every new detection against what else is known about the brand. Low-value noise is dismissed automatically, with the reason recorded, so your queue holds what needs a decision.",
  },
  {
    name: "Infrastructure correlation",
    role: "The campaign behind an alert",
    plan: "Enterprise",
    text: "Links phishing domains, IPs and certificates that share infrastructure into operations. On Enterprise, threats are linked to the campaign they belong to, and you're alerted when a significant campaign or a known actor targets your brand.",
  },
  {
    name: "DNS resolution",
    role: "Where a threat lives",
    text: "Resolves the domains and hostnames behind threats to IP addresses, keeping infrastructure data current as attackers rotate hosting.",
  },
  {
    name: "Geo and provider mapping",
    role: "Hosting and region",
    text: "Maps resolved infrastructure to where it's hosted, by provider, region and network, so attacks from the same infrastructure read as one picture.",
  },
  {
    name: "Plain-language summaries",
    role: "Readable, and tied to evidence",
    text: "Writes a short summary of each situation from the same evidence, so the explanation always matches the signals and you can act without reading raw records.",
  },
];

const ratingRows: SampleRow[] = [
  { text: "acme-secure-login.example", mono: true, status: "Live web and mail servers", pill: "Lookalike", tone: "med" },
  { text: "acme-payroll-login.example", mono: true, status: "Live web and mail servers", pill: "Lookalike", tone: "med" },
  { text: "@acme_support", mono: true, status: "X, not your official account", pill: "Likely fake", tone: "high" },
  { text: "acme.example", mono: true, status: "Email authentication", pill: "Weak", tone: "med" },
];

type Status = "business" | "request" | "roadmap";
const STATUS_LABEL: Record<Status, string> = {
  business: "Business and Enterprise",
  request: "On request",
  roadmap: "Roadmap",
};
const integrations: Array<{ name: string; desc: string; status: Status }> = [
  { name: "Webhooks", desc: "Alert and takedown events, set up with our team.", status: "business" },
  { name: "Splunk", desc: "SIEM connector, set up with our team.", status: "business" },
  { name: "Microsoft Sentinel", desc: "SIEM connector, set up with our team.", status: "business" },
  { name: "QRadar", desc: "SIEM connector, set up with our team.", status: "business" },
  { name: "Jira and ServiceNow", desc: "Ticketing connectors, set up with our team.", status: "business" },
  { name: "STIX 2.1 export", desc: "A standard threat-intelligence format, delivered by our team.", status: "request" },
  { name: "Slack", desc: "Team alert channels.", status: "roadmap" },
];
---

<ProductPage
  title="Digital Risk Protection Platform — Averrow"
  description="Averrow watches eight places impersonation happens, brings every finding into one queue with its evidence, and files takedowns under rules you set."
>
  <ProductHero
    eyebrow="The platform"
    title="Every place your brand is impersonated, in one queue."
    sub="Averrow watches eight places impersonation happens, brings every finding into one queue with its evidence, and files takedowns under rules you set."
  >
    <SampleFrame slot="sample" label="Sample findings across surfaces" rows={queueRows} footer="One queue, every surface, with the evidence" />
  </ProductHero>

  <ProofStrip stats={["threats", "operations", "brands", "lookalikes"]} />
  <p class="pv-status">Platform health is public. <a href={`${base}/status`}>View live status &rarr;</a></p>

  <Coverage showProof={false} />

  <RelatedSurfaces
    current="/platform"
    include={["/platform/takedowns", "/platform/threat-detection", "/platform/campaign-intelligence"]}
    eyebrow="Beyond the eight surfaces"
    heading="What happens after a finding"
  />

  <ProductSection
    id="how-it-works"
    eyebrow="How it works"
    heading="Rule-based analysis you can check."
    lede="Detection and correlation run on deterministic rules, so every score traces back to evidence you can see. There is no black box between a signal and the decision."
  >
    <ol class="pv-stages" role="list">
      {stages.map((s, i) => (
        <li class="pv-stage">
          <span class="pv-n" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{s.name}{s.plan && <span class="pv-plan">{s.plan}</span>}</h3>
            <span class="pv-role">{s.role}</span>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="pv-rate">
      <div class="pv-rate-copy">
        <h3>One situation, rated as one.</h3>
        <p>
          Averrow looks at look-alikes, impersonation accounts, app listings, leak-site mentions,
          certificates and your email posture together and rates the situation as one, not as a
          list of unrelated rows.
        </p>
        <p>
          The same signals feed one exposure score per brand, which combines active threats,
          impersonation, app listings, leak-site mentions and email posture.
        </p>
      </div>
      <SampleFrame label="Sample situation rating" rows={ratingRows} footer="Rated High, as one situation" />
    </div>
  </ProductSection>

  <ProductSection
    id="integrations"
    eyebrow="Integrations"
    heading="Works with your existing stack."
    lede="Alerts appear in your Averrow console. On Business and Enterprise they can also go to your webhook or SIEM, set up with our team."
  >
    <ul class="pv-int" role="list">
      {integrations.map((i) => (
        <li>
          <b>{i.name}</b>
          <span>{i.desc}</span>
          <em class={i.status}>{STATUS_LABEL[i.status]}</em>
        </li>
      ))}
    </ul>
  </ProductSection>

  <PageCTA />
</ProductPage>

<style>
  .pv-status { max-width: 1280px; margin: 0 auto; padding: 4px 24px 0; font: 500 13px var(--font-mono); color: var(--text-secondary); }
  .pv-status a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .pv-status a:hover { border-bottom-color: var(--accent); }

  .pv-stages { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .pv-stage {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    min-width: 0;
  }
  .pv-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    font: 600 12px var(--font-mono);
    color: var(--text-secondary);
  }
  .pv-stage > div { display: grid; gap: 4px; min-width: 0; }
  .pv-stage h3 { margin: 0; font: 700 16px var(--font-display); color: var(--text-primary); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .pv-plan {
    font: 600 12px var(--font-mono);
    color: var(--btn-primary-ink);
    background: var(--btn-primary-bg);
    border-radius: 999px;
    padding: 1px 9px;
  }
  .pv-role { font: 600 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-secondary); }
  .pv-stage p { margin: 4px 0 0; font-size: 14px; line-height: 1.55; color: var(--text-secondary); }

  .pv-rate { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: center; margin-top: 16px; }
  .pv-rate-copy { display: grid; gap: 12px; min-width: 0; }
  .pv-rate-copy h3 { margin: 0; font: 800 22px/1.15 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); }
  .pv-rate-copy p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-secondary); max-width: 56ch; }

  .pv-int { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
  .pv-int li {
    display: grid;
    gap: 6px;
    align-content: start;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    min-width: 0;
  }
  .pv-int b { font: 700 15px var(--font-display); color: var(--text-primary); }
  .pv-int span { font-size: 13.5px; line-height: 1.5; color: var(--text-secondary); }
  .pv-int em {
    justify-self: start;
    font: 600 12px var(--font-mono);
    font-style: normal;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 1px 9px;
    color: var(--text-secondary);
  }
  .pv-int em.business { color: var(--sev-low-text); border-color: var(--sev-low-text); }
  .pv-int em.request { color: var(--amber-text); border-color: var(--amber-text); }

  @media (max-width: 1100px) {
    .pv-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .pv-rate { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
  @media (max-width: 640px) {
    .pv-stages { grid-template-columns: minmax(0, 1fr); }
    .pv-status { padding: 4px 16px 0; }
  }
</style>
