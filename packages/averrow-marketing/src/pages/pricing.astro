---
/*
 * Plans page (URL stays /pricing). Plan grid, "what you replace"
 * value-prop, full feature comparison table, trust signals strip,
 * FAQ, CTA. No prices are shown anywhere (owner decision 2026-10-05).
 */
import Layout from "../layouts/Layout.astro";
import TrustSignals from "../components/TrustSignals.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title="Plans — Averrow"
  description="Averrow plans are built around the coverage you need: Professional, Business and Enterprise. Run a free domain scan with no signup, or book a demo."
>
  <section class="pricing-hero">
    <div class="container">
      <div class="section-label" style="text-align:center;">Plans</div>
      <h1>Plans built around<br />what you need watched.</h1>
      <p>
        Brand protection, email-security monitoring, and threat
        intelligence are usually bought as separate tools &mdash; and
        staffed separately. Averrow brings all three into one platform.
        Start with a free scan, then book a demo and we&rsquo;ll scope
        the right plan with you.
      </p>
    </div>
  </section>

  <section class="value-prop">
    <div class="value-prop-inner">
      <div class="section-label" style="text-align:center;">What You Replace</div>
      <div class="value-prop-grid">
        <div class="value-prop-item">
          <div class="value-prop-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="value-prop-title">Brand Protection Platform</div>
          <div class="value-prop-desc">Averrow detects impersonation, phishing domains, and social media abuse.</div>
        </div>
        <div class="value-prop-item">
          <div class="value-prop-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2 8 12 14 22 8"/></svg>
          </div>
          <div class="value-prop-title">Email Security Monitoring</div>
          <div class="value-prop-desc">Continuous SPF, DKIM, DMARC assessment with A+ through F grading.</div>
        </div>
        <div class="value-prop-item">
          <div class="value-prop-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/></svg>
          </div>
          <div class="value-prop-title">Threat Intelligence Feeds</div>
          <div class="value-prop-desc">40+ threat &amp; intelligence sources ingested and correlated automatically.</div>
        </div>
        <div class="value-prop-item">
          <div class="value-prop-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="value-prop-title">Analyst Workload</div>
          <div class="value-prop-desc">Automated triage and rule-based correlation, running around the clock, so your team reviews decisions instead of raw alerts.</div>
        </div>
      </div>
    </div>
  </section>


  <section class="pricing-section">
    <div class="pricing-grid-hint">
      Start with the free scan
      <span class="pricing-grid-hint-arrow">&rarr;</span>
      book a demo when you&rsquo;re ready
    </div>
    <div class="pricing-grid">
      <div class="price-card free-scan">
        <div class="price-tier">Free Scan</div>
        <div class="price-desc">Domain scan &middot; free, no signup</div>
        <div class="price-divider"></div>
        <ul class="price-features">
          <li>Email authentication grade, A+ to F (SPF, DKIM, DMARC, MX, BIMI)</li>
          <li>Count of registered lookalike domains</li>
          <li>Report by email for work addresses matching your domain; otherwise our team follows up</li>
        </ul>
        <div class="price-cta">
          <a href={`${base}/scan`} class="btn btn-outline" data-cta="pricing-free">Scan your domain</a>
        </div>
      </div>

      <div class="price-card popular">
        <span class="popular-badge">POPULAR</span>
        <div class="price-tier">Professional</div>
        <div class="price-desc">For growing companies</div>
        <div class="price-divider"></div>
        <ul class="price-features">
          <li>Everything in the free scan, monitored continuously</li>
          <li>Domain monitoring: lookalike domains and certificate-transparency checks</li>
          <li>Social impersonation monitoring (X, LinkedIn, Instagram, TikTok, GitHub, YouTube)</li>
          <li>Executive impersonation: accounts using your executives' names that aren't their official handles</li>
          <li>Look-alike apps on the Apple App Store</li>
          <li>Takedowns for lookalike domains and phishing URLs, submitted under an authorization you sign</li>
          <li>Email security posture monitoring</li>
        </ul>
        <div class="price-cta">
          <a href={`${base}/demo`} class="btn btn-primary" data-cta="pricing-professional">Book a demo</a>
        </div>
      </div>

      <div class="price-card">
        <div class="price-tier">Business</div>
        <div class="price-desc">Full-spectrum brand defense</div>
        <div class="price-divider"></div>
        <ul class="price-features">
          <li>Everything in Professional</li>
          <li>Dedicated account manager</li>
          <li>Dark web monitoring: paste-site and ransomware leak-site mentions of your brand</li>
          <li>Trademark monitoring: misuse of your name across domains, social and apps in one view</li>
          <li>Webhooks for alert and takedown events, and Splunk, Microsoft Sentinel, QRadar, Jira and ServiceNow connectors &mdash; set up with our team</li>
          <li>STIX 2.1 export, available on request</li>
        </ul>
        <div class="price-cta">
          <a href={`${base}/demo`} class="btn btn-outline" data-cta="pricing-business">Book a demo</a>
        </div>
      </div>

      <div class="price-card">
        <div class="price-tier">Enterprise</div>
        <div class="price-desc">Tailored to your organization</div>
        <div class="price-divider"></div>
        <ul class="price-features">
          <li>Everything in Business</li>
          <li><a href={`${base}/platform/abuse-mailbox`} style="color:inherit;text-decoration:underline;text-underline-offset:2px;white-space:nowrap;">Abuse Mailbox</a> &mdash; branded report inbox with automatic classification</li>
          <li>Threat-actor intelligence: infrastructure correlation into operations and campaigns</li>
          <li>SLAs set in your contract</li>
          <li>Dedicated support</li>
          <li>Onboarding &amp; training</li>
        </ul>
        <div class="price-cta">
          <a href={`${base}/contact`} class="btn btn-outline" data-cta="pricing-enterprise">Talk to sales</a>
        </div>
      </div>
    </div>
  </section>

  <section class="compare-section" id="compare">
    <div class="container" style="text-align:center;">
      <div class="section-label" style="text-align:center;">Compare Plans</div>
      <h2 class="compare-heading">Everything you need, at every stage</h2>
    </div>
    <p class="compare-swipe-hint" aria-hidden="true">Swipe to compare &rarr;</p>
    <div class="compare-table-wrap">
      <table class="compare-table">
        <caption class="sr-only">Plan comparison: which capabilities each plan includes</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Capability</span></th>
            <th scope="col">Free Scan</th>
            <th scope="col" class="highlight">Professional</th>
            <th scope="col">Business</th>
            <th scope="col">Enterprise</th>
          </tr>
        </thead>
        <tbody>
          <tr><td role="rowheader">Monitoring</td><td>One-time</td><td>Continuous 24/7</td><td>Continuous 24/7</td><td>Continuous 24/7</td></tr>
          <tr><td role="rowheader">Email Security Posture</td><td>Grade A+ to F</td><td class="ct-yes"><span aria-hidden="true">&#10003;</span> Full monitoring</td><td class="ct-yes"><span aria-hidden="true">&#10003;</span> Full monitoring</td><td class="ct-yes"><span aria-hidden="true">&#10003;</span> Full monitoring</td></tr>
          <tr><td role="rowheader">Domain Monitoring (lookalikes, certificate transparency)</td><td>Registered-lookalike count</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Social Media Monitoring</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Executive Impersonation</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Apple App Store Monitoring</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Dark Web Monitoring (paste sites, ransomware leak sites)</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Trademark Monitoring</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Webhooks &amp; SIEM / ticketing connectors (set up with our team)</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">STIX 2.1 Export</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td>On request</td><td>On request</td></tr>
          <tr><td role="rowheader">Dedicated Account Manager</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Abuse Mailbox</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Threat-Actor Intelligence (operations &amp; campaigns)</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
          <tr><td role="rowheader">Contractual SLAs</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-no" role="cell" aria-label="Not included">&#10007;</td><td class="ct-yes" role="cell" aria-label="Included">&#10003;</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="trust-signals">
    <TrustSignals />
  </section>

  <section class="faq-section">
    <div class="container" style="text-align:center;">
      <h2 class="faq-heading">Frequently Asked Questions</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item">
        <button class="faq-q" data-faq-toggle id="faq-q-1" aria-expanded="false" aria-controls="faq-a-1">How does the free scan work? <span class="faq-arrow" aria-hidden="true">&#9660;</span></button>
        <div class="faq-a" id="faq-a-1" role="region" aria-labelledby="faq-q-1">Enter any domain for an email-authentication grade (A+ to F) and a count of likely lookalike domains that are already registered, no signup. It usually takes under a minute. The report is emailed to you when your work email matches the domain; otherwise our team follows up.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" data-faq-toggle id="faq-q-2" aria-expanded="false" aria-controls="faq-a-2">What&rsquo;s included in continuous monitoring? <span class="faq-arrow" aria-hidden="true">&#9660;</span></button>
        <div class="faq-a" id="faq-a-2" role="region" aria-labelledby="faq-q-2">Professional and above monitor continuously across the modules in your plan. Alerts land in your Averrow console; Business and Enterprise can also send them to a webhook or SIEM, set up with our team.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" data-faq-toggle id="faq-q-3" aria-expanded="false" aria-controls="faq-a-3">How is Averrow priced? <span class="faq-arrow" aria-hidden="true">&#9660;</span></button>
        <div class="faq-a" id="faq-a-3" role="region" aria-labelledby="faq-q-3">By the coverage you need. Book a demo and we&rsquo;ll scope it with you.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" data-faq-toggle id="faq-q-4" aria-expanded="false" aria-controls="faq-a-4">Can I change plans later? <span class="faq-arrow" aria-hidden="true">&#9660;</span></button>
        <div class="faq-a" id="faq-a-4" role="region" aria-labelledby="faq-q-4">Yes &mdash; talk to us and we&rsquo;ll change your coverage.</div>
      </div>
      <div class="faq-item">
        <button class="faq-q" data-faq-toggle id="faq-q-5" aria-expanded="false" aria-controls="faq-a-5">How do I get started? <span class="faq-arrow" aria-hidden="true">&#9660;</span></button>
        <div class="faq-a" id="faq-a-5" role="region" aria-labelledby="faq-q-5">Run the free domain scan on your own domain &mdash; no signup. When you want continuous monitoring, book a demo and our team will set you up.</div>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="container">
      <h2>Ready to protect your brand?</h2>
      <p>Start with the free domain scan or book a demo to find the right plan for you.</p>
      <div class="cta-actions">
        <a href={`${base}/scan`} class="btn btn-primary" data-cta="run-scan">Scan your domain</a>
        <a href={`${base}/demo`} class="btn btn-outline" data-cta="book-demo">Book a demo</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .pricing-hero { padding: 5rem 0 2.5rem; text-align: center; background: var(--gradient-hero); }
  .pricing-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .pricing-hero p {
    font-size: 18px;
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .value-prop { padding: 3rem 0 1rem; }
  .value-prop-inner { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
  .value-prop-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .value-prop-item {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all 0.3s;
  }
  .value-prop-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-glow);
  }
  .value-prop-icon { font-size: 1.5rem; margin-bottom: 0.75rem; }
  .value-prop-title {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-section, var(--accent));
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }
  .value-prop-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .pricing-section { padding: 3rem 0; }
  .pricing-grid {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .price-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s;
  }
  .price-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .price-card.popular {
    border-color: var(--accent);
    border-radius: var(--radius-lg);
    box-shadow: inset 0 0 0 1px var(--accent), var(--shadow-glow);
  }
  .price-card.popular::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--accent);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }

  .pricing-grid-hint {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 1.75rem;
  }
  .pricing-grid-hint-arrow { color: var(--amber-text); margin: 0 6px; }

  .price-card.free-scan {
    background: transparent;
    border: 1.5px dashed var(--border-strong);
    position: relative;
  }
  .price-card.free-scan::before {
    content: "TRY FIRST";
    position: absolute;
    top: -10px;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    background: var(--bg-primary);
    padding: 2px 8px;
    color: var(--amber-text);
    border-radius: 6px;
    border: 1px solid var(--border);
  }

  .popular-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--btn-primary-bg);
    color: var(--btn-primary-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    letter-spacing: 0.05em;
  }
  .price-tier {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .price-desc { font-size: 15px; color: var(--text-tertiary); margin-bottom: 1.25rem; }
  .price-divider { height: 1px; background: var(--border); margin-bottom: 1.5rem; }
  .price-features {
    list-style: none;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .price-features li {
    font-size: 15px;
    color: var(--text-secondary);
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .price-features li::before {
    content: "\2713";
    color: var(--green);
    font-weight: 700;
    flex-shrink: 0;
  }
  .price-cta { margin-top: auto; }
  .price-cta .btn { width: 100%; justify-content: center; }

  .compare-section { padding: 3rem 0; background: var(--bg-tertiary); }
  .compare-heading {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
  }
  .compare-table-wrap {
    max-width: 1400px;
    margin: 2rem auto 0;
    padding: 0 2rem;
    overflow-x: auto;
    position: relative;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .compare-table th {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    text-align: left;
    padding: 1rem;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border);
  }
  .compare-table th.highlight { color: var(--accent); }
  .compare-table td {
    font-size: 14px;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }
  .compare-table tr:last-child td { border-bottom: none; }
  .compare-table td.ct-yes { color: var(--green-text); }
  .compare-table td.ct-no { color: var(--red-text); }
  .compare-table tbody td:first-child {
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    text-transform: none;
    letter-spacing: normal;
    color: var(--text-primary);
    background: var(--bg-secondary);
    padding: 0.85rem 1rem;
  }
  .compare-swipe-hint { display: none; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  .faq-section { padding: 3rem 0; }
  .faq-heading {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 700;
  }
  .faq-list { max-width: 720px; margin: 2rem auto 0; padding: 0 2rem; }
  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-q {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    padding: 1.25rem 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    color: var(--text-primary);
  }
  .faq-q:hover { color: var(--accent); }
