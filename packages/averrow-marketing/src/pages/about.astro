---
/*
 * About (Section 9B). Who is behind Averrow, what it does, and the three
 * principles. This is the only page that states the principles; /company,
 * /why-averrow and the press kit do not repeat them.
 *
 * Disclosure (docs/DISCLOSURE_REGISTER.md L36, L42, L44, section 3.11): the
 * founder is named (Claude Leroux) with role only: no biography, prior
 * employers, dates, photo or quote, and no gendered pronouns. The "why" line is
 * a company statement. No team size, offices or funding. "File takedowns", never
 * "shut down". SOC 2 Type I is "in preparation".
 */
import ProductPage from "../components/product/ProductPage.astro";
import ProductHero from "../components/product/ProductHero.astro";
import ProductSection from "../components/product/ProductSection.astro";
import FactList from "../components/product/FactList.astro";
import PageCTA from "../components/product/PageCTA.astro";
import { LEGAL_ENTITY } from "../lib/company";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const does = [
  { lead: "Look-alike domains.", text: "Finds domains registered to imitate your brand, and keeps checking them." },
  { lead: "Impersonation.", text: "Finds fake social profiles and copycat apps that use your name." },
  { lead: "Email authentication.", text: "Checks your domain's email authentication and gives it one grade." },
  { lead: "Takedowns.", text: "Files takedowns for look-alike domains and phishing URLs under an authorization you control. Hosting providers and registrars decide whether to remove content." },
];

const principles = [
  { lead: "Outside-in first.", text: "Averrow starts from what attackers can see: public signals about your brand. There is nothing to install and no records to hand over to get a first answer." },
  { lead: "Evidence you can trace.", text: "Every score traces back to evidence you can see: deterministic correlation, no black box." },
  { lead: "Open before you buy.", text: "The domain scan is free and needs no signup, so you can see your exposure before you talk to anyone." },
];
---

<ProductPage
  title="About — Averrow"
  description="Averrow is operated by LRX Enterprises Inc., a Canadian company, and founded by Claude Leroux. What Averrow does and the principles it works by."
>
  <ProductHero
    eyebrow="About"
    plan={null}
    title="Built to get ahead of threat actors."
    sub={`Averrow shows a company its brand the way attackers see it, and files takedowns for the look-alike domains and phishing URLs it finds. It is operated by ${LEGAL_ENTITY}, a Canadian company.`}
  />

  <ProductSection id="founder" eyebrow="Founder" heading="Founded by Claude Leroux">
    <div class="ab-founder">
      <div class="ab-id">
        <div class="ab-name">Claude Leroux</div>
        <div class="ab-role">Founder of Averrow</div>
      </div>
      <p class="ab-why">
        Averrow exists because the outside-in view of a brand's threats has typically been built for large enterprises,
        while companies of every size are targeted by phishing and brand impersonation. Averrow aims to put that view
        within reach of all of them.
      </p>
    </div>
  </ProductSection>

  <ProductSection id="what" eyebrow="What it does" heading="What Averrow does" lede="Four jobs, one place. The platform pages show each one in detail.">
    <FactList items={does} label="What Averrow does" />
    <p class="ab-link"><a href={`${base}/platform`}>See the platform</a></p>
  </ProductSection>

  <ProductSection id="principles" eyebrow="Principles" heading="How Averrow works">
    <FactList items={principles} label="Principles" />
  </ProductSection>

  <ProductSection id="trust" eyebrow="Trust" heading="Where we are on compliance">
    <p class="ab-trust">
      SOC 2 Type I is in preparation. What is in place today, and what is not, is on
      <a href={`${base}/security`}>Security and trust</a>. For the company itself, see <a href={`${base}/company`}>Company</a>.
    </p>
  </ProductSection>

  <PageCTA />
</ProductPage>

<style>
  .ab-founder {
    display: grid;
    grid-template-columns: minmax(180px, 0.45fr) minmax(0, 1fr);
    gap: 20px 32px;
    align-items: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    padding: 24px;
  }
  .ab-name { font: 800 clamp(24px, 3vw, 32px) / 1.1 var(--font-display); letter-spacing: -0.02em; color: var(--text-primary); }
  .ab-role { margin-top: 6px; font: 600 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-secondary); }
  .ab-why { margin: 0; font-size: 16px; line-height: 1.65; color: var(--text-secondary); max-width: 64ch; }
  .ab-link, .ab-trust { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-secondary); max-width: 64ch; }
  .ab-link a, .ab-trust a { color: var(--text-primary); border-bottom: 1px solid var(--border-strong); text-decoration: none; }
  .ab-link a:hover, .ab-trust a:hover { border-bottom-color: var(--accent); }
  @media (max-width: 720px) { .ab-founder { grid-template-columns: minmax(0, 1fr); padding: 18px 16px; } }
</style>
