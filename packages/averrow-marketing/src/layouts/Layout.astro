---
/*
 * Root document shell — used by every Astro page.
 *
 * Equivalent to wrapPage() in packages/averrow-worker/src/templates/shared.ts.
 * Renders the full <!doctype html>, head meta, pre-paint theme script,
 * top nav, page body, footer.
 *
 * The theme toggle island is mounted in Footer.astro; this layout just
 * sets data-theme via the pre-paint inline script (dark unless the visitor
 * saved "light") so first paint is correct without a flash.
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Optional override for noindex meta (e.g. for the R1 skeleton). */
  noindex?: boolean;
  /** Open Graph / Twitter share image path. Absolute-ized against the site origin. */
  ogImage?: string;
  /** Open Graph type — "website" (default) or "article" for blog posts. */
  ogType?: string;
  /** Optional extra JSON-LD block (e.g. Article on blog posts). */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  noindex = false,
  ogImage = "/brand/og-r3-2026.png",
  ogType = "website",
  jsonLd,
} = Astro.props;

const siteOrigin = new URL(Astro.site ?? "https://averrow.com").origin;
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const ogImageUrl = new URL(ogImage, siteOrigin).toString();

// Site-wide Organization structured data. Kept factual and on-positioning
// (global threat-intel + brand protection; no aviation/military framing).
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Averrow",
  url: siteOrigin,
  logo: new URL("/brand/averrow-r3-512.png", siteOrigin).toString(),
  image: ogImageUrl,
  description:
    "Brand protection that traces the operation. Averrow (Digital Risk Protection, DRPS) finds lookalike domains, impersonation accounts and copycat apps aimed at your brand and files takedowns for lookalike domains and phishing URLs under your authorization. Enterprise adds operation mapping: phishing domains, IPs and certificates that share hosting or certificates are grouped into one operation, and you're alerted when a campaign targets your brand.",
  parentOrganization: { "@type": "Organization", name: "LRX Enterprises Inc." },
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Averrow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Averrow — threat intelligence" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Averrow — threat intelligence" />

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" href="/favicon-r3.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-r3.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-r3.png" />
    <!-- Browser chrome colour per theme (graphite / light page). The pre-paint
         script below pins both to the stored theme, since the site ignores
         prefers-color-scheme. -->
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0b0e" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f0f2f8" />
    <link rel="alternate" type="application/rss+xml" title="Averrow Blog" href="/blog/feed.xml" />
    <link rel="alternate" type="application/rss+xml" title="Averrow Changelog" href="/changelog/feed.xml" />
    <!-- Self-hosted Geist (see global.css @font-face). Both faces render above the fold. -->
    <link rel="preload" href="/fonts/averrow-geist-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/averrow-geist-mono-var.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Pre-paint theme load — avoids a flash. Dark is the default: only an
      // explicit saved "light" switches it. prefers-color-scheme is
      // intentionally ignored; the footer toggle is the only way to change it.
      (function () {
        var theme = "dark";
        try {
          if (localStorage.getItem("averrow-theme") === "light") theme = "light";
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", theme);
        var tc = document.querySelectorAll('meta[name="theme-color"]');
        for (var i = 0; i < tc.length; i++) tc[i].setAttribute("content", theme === "light" ? "#f0f2f8" : "#0a0b0e");
      })();
    </script>
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="content" class="page-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Tiny privacy-safe analytics beacon. No cookies, no PII, no
      // third-party libs, no batching/queueing/localStorage — fire and
      // forget via sendBeacon (fetch keepalive fallback). Sends a
      // pageview on load + a "cta" event on clicks of tagged elements.
      (function () {
        if (!("sendBeacon" in navigator) && !("fetch" in window)) return;

        function send(payload) {
          try {
            const json = JSON.stringify(payload);
            if (navigator.sendBeacon) {
              navigator.sendBeacon("/api/track", new Blob([json], { type: "application/json" }));
            } else {
              fetch("/api/track", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: json,
                keepalive: true,
              }).catch(() => {});
            }
          } catch (e) {}
        }

        try {
          send({ type: "pageview", page: location.pathname, ref: document.referrer || "" });
        } catch (e) {}

        try {
          document.addEventListener(
            "click",
            function (event) {
              try {
                const el = event.target && event.target.closest ? event.target.closest("a[data-cta], button[data-cta]") : null;
                if (!el) return;
                send({ type: "cta", page: location.pathname, ctaId: el.dataset.cta || "" });
              } catch (e) {}
            },
            true
          );
        } catch (e) {}
      })();
    </script>
  </body>
</html>

<style>
  /* Accessibility: skip link — visually hidden until keyboard-focused. */
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    z-index: 1000;
    padding: 0.6rem 1rem;
    background: var(--primary);
    color: var(--primary-ink);
    font-family: var(--font-display);
    font-weight: 700;
    border-radius: 0 0 8px 8px;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 0;
    outline: 2px solid var(--primary-ink);
    outline-offset: 2px;
  }
</style>
