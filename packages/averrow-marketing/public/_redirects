# absorbed into /solutions/mssp; /press and /careers become anchors on /company;
# startups points at the free scan (its "why new companies get targeted" copy
# now sits on /scan); mid-market is replaced by teams-without-a-soc.
/partners /solutions/mssp 301
/partners/ /solutions/mssp 301
/press /company#press 301
/press/ /company#press 301
